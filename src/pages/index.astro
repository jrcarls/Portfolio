import Experiences from "@/components/Experiences.astro";
import ScrollTextLines from "@/components/ScrollTextLines.astro";
import Sobre from "@/components/Sobre.astro";
import Contact from "@/components/Contact.astro";
import Footer from "@/components/Footer.astro";
---

<Layout>
  <div id="page-shell" class="relative z-10 bg-background">
    <Hero />
    <Projects />
    <Skills />
    <Experiences />
    <ScrollTextLines />
    <Sobre />
    <Contact />
  </div>
  <Footer />
</Layout>
