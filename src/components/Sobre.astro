---
const lines = [
  "Sou engenheiro de software com cinco anos de experiência no desenvolvimento de soluções digitais.",
  "Atuo no ciclo completo, do levantamento de requisitos e modelagem de dados à entrega e evolução do produto.",
  "Com Python e TypeScript, desenvolvo aplicações web, APIs e integrações orientadas às necessidades do negócio.",
  "Também integro LLMs e soluções inteligentes quando elas geram valor real.",
  "Antes da tecnologia, procuro entender o problema, o usuário e o resultado esperado.",
];

const fullText = lines.join(" ");
---

<section id="sobre" class="relative h-[220vh]">
  <div
    id="sobre-sticky"
    class="sticky top-16 z-10 h-[calc(100vh-4rem)] flex flex-col justify-center overflow-hidden bg-background"
  >
    <div class="max-w-6xl mx-auto w-full px-4 sm:px-6">
      <div class="mb-16 sm:mb-20">
        <h2
          class="text-2xl sm:text-4xl font-semibold uppercase tracking-[0.28em] text-muted-foreground"
        >
          Sobre mim
        </h2>
      </div>

      <div
        id="typewriter"
        class="min-h-[12rem] sm:min-h-[14rem]"
        data-text={fullText}
        aria-live="polite"
        aria-atomic="true"
      >
        <p
          id="typewriter-text"
          class="font-[family-name:var(--font-impact)] text-[clamp(1.35rem,4.2vw,2.35rem)] font-medium leading-[1.35] tracking-[-0.02em] text-foreground"
        >
          <span id="typewriter-content"></span><span
            id="typewriter-cursor"
            class="typewriter-cursor inline-block w-[0.08em] h-[0.9em] ml-[0.06em] align-[-0.05em] bg-primary"
            aria-hidden="true"></span>
        </p>
      </div>

      <p
        id="sobre-meta"
        class="mt-10 text-sm text-muted-foreground/70 tracking-wide opacity-0"
      >
        Jean Reis · Salvador, BA
      </p>
    </div>
  </div>
</section>

<style>
  .typewriter-cursor {
    animation: cursor-blink 1s steps(1) infinite;
  }

  @keyframes cursor-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  :global(html.nav-hidden) #sobre-sticky {
    top: 0;
    height: 100vh;
  }

  :global(html.reduced-motion) .typewriter-cursor {
    animation: none;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    #sobre {
      height: auto;
    }

    #sobre-sticky {
      position: relative;
      top: 0;
      height: auto;
      padding-block: 6rem;
    }

    #sobre-meta {
      opacity: 1 !important;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const section = document.getElementById("sobre");
  const root = document.getElementById("typewriter");
  const contentEl = document.getElementById("typewriter-content");
  const metaEl = document.getElementById("sobre-meta");
  const fullText = root?.dataset.text ?? "";

  if (section && contentEl && fullText) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const total = fullText.length;

    if (reduced) {
      document.documentElement.classList.add("reduced-motion");
      contentEl.textContent = fullText;
      if (metaEl) metaEl.style.opacity = "1";
    } else {
      let lastLen = -1;

      const setProgress = (progress: number) => {
        const p = Math.max(0, Math.min(1, progress));
        const len = Math.round(p * total);
        if (len === lastLen) return;
        lastLen = len;
        contentEl.textContent = fullText.slice(0, len);

        if (metaEl) {
          const metaOpacity = p > 0.88 ? (p - 0.88) / 0.12 : 0;
          metaEl.style.opacity = String(Math.max(0, Math.min(1, metaOpacity)));
        }
      };

      setProgress(0);

      ScrollTrigger.create({
        trigger: section,
        start: "top top+=64",
        end: "bottom bottom",
        scrub: 0.4,
        invalidateOnRefresh: true,
        onUpdate: (self) => setProgress(self.progress),
        onRefresh: (self) => setProgress(self.progress),
      });
    }
  }
</script>
