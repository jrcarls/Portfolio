---

<section class="py-16 overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 mb-10 text-center" data-reveal>
    <span
      class="inline-block rounded-full border border-border bg-muted/80 backdrop-blur-sm px-4 py-1.5 text-sm text-muted-foreground mb-4"
    >
      Stack
    </span>
    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight">
      Tecnologias que domino
    </h2>
  </div>

  <div id="techstack-marquee" style="opacity:0;transform:translateY(24px)">
    <Marquee time={35} class="py-2">
      {
        techs.map((tech) => (
          <div class="mx-4 flex items-center gap-2.5 rounded-full border border-border bg-card px-5 py-2.5 shadow-sm transition-shadow hover:shadow-md">
            <span class={tech.color}>
              <Fragment set:html={tech.icon} />
            </span>
            <span class="text-sm font-medium whitespace-nowrap">{tech.name}</span>
          </div>
        ))
      }
    </Marquee>
  </div>
</section>

<script>
  import { animate, inView } from "motion";

  inView("#techstack-marquee", () => {
    animate(
      "#techstack-marquee",
      { opacity: [0, 1], y: [24, 0] },
      { duration: 0.7, easing: [0.25, 0.1, 0.25, 1] },
    );
  }, { amount: 0.3 });
</script>
