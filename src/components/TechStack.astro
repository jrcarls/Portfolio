    icon: `<svg viewBox="0 0 24 24" fill="currentColor" class="size-5"><path d="M12.001 4.8c-3.2 0-5.2 1.6-6 4.8 1.2-1.6 2.6-2.2 4.2-1.8.913.228 1.565.89 2.288 1.624C13.666 10.618 15.027 12 18.001 12c3.2 0 5.2-1.6 6-4.8-1.2 1.6-2.6 2.2-4.2 1.8-.913-.228-1.565-.89-2.288-1.624C16.337 6.182 14.976 4.8 12.001 4.8zm-6 7.2c-3.2 0-5.2 1.6-6 4.8 1.2-1.6 2.6-2.2 4.2-1.8.913.228 1.565.89 2.288 1.624 1.177 1.194 2.538 2.576 5.512 2.576 3.2 0 5.2-1.6 6-4.8-1.2 1.6-2.6 2.2-4.2 1.8-.913-.228-1.565-.89-2.288-1.624C10.337 13.382 8.976 12 6.001 12z"/></svg>`,
    color: "text-cyan-400",
  },
];
---

<section class="py-16 overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 mb-10 text-center" data-reveal>
    <span
      class="inline-block rounded-full border border-border bg-muted px-4 py-1.5 text-sm text-muted-foreground mb-4"
    >
      Stack
    </span>
    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight">
      Tecnologias que domino
    </h2>
  </div>

  <div id="techstack-marquee" style="opacity:0;transform:translateY(24px)">
    <Marquee time={35} class="py-2">
      {
        techs.map((tech) => (
          <div class="mx-4 flex items-center gap-2.5 rounded-full border border-border bg-card px-5 py-2.5 shadow-sm transition-shadow hover:shadow-md">
            <span class={tech.color}>
              <Fragment set:html={tech.icon} />
            </span>
            <span class="text-sm font-medium whitespace-nowrap">{tech.name}</span>
          </div>
        ))
      }
    </Marquee>
  </div>
</section>

<script>
  import { animate, inView } from "motion";

  inView("#techstack-marquee", () => {
    animate(
      "#techstack-marquee",
      { opacity: [0, 1], y: [24, 0] },
      { duration: 0.7, easing: [0.25, 0.1, 0.25, 1] },
    );
  }, { amount: 0.3 });
</script>
