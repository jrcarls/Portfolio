---
import { Button } from "@/ui/button";

const services = [
  {
    id: "analise",
    tag: "Análise",
    title: "Análise de Requisitos & Arquitetura de Solução",
    description:
      "Antes de codar, entendo o problema. Mapeio processos, requisitos e restrições do negócio para desenhar a arquitetura e a stack certas para o seu caso.",
    deliverables: [
      "Levantamento e documentação de requisitos",
      "Mapeamento de processos e fluxos de dados",
      "Definição de arquitetura e stack adequada ao problema",
      "Diagnóstico técnico com plano de ação claro",
      "Escopo, prazo e orçamento definidos antes de começar",
    ],
    tags: ["Requisitos", "Arquitetura", "Diagnóstico", "Documentação"],
    primaryTag: "Arquitetura",
    cta: "Quero uma análise",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>`,
    accentBorder: "border-t-2 border-t-sky-500/70",
    tagLabel: "text-sky-500 dark:text-sky-400",
    iconBg: "bg-sky-500/10 text-sky-600 dark:text-sky-400 group-hover:bg-sky-500/15",
    checkColor: "text-sky-500 dark:text-sky-400",
    tagBase: "bg-sky-500/10 border-sky-500/20 text-sky-700 dark:text-sky-400",
    tagHighlight: "bg-sky-500/20 border-sky-500/40 text-sky-700 dark:text-sky-300 font-medium",
  },
  {
    id: "desenvolvimento",
    tag: "Desenvolvimento",
    title: "Sistemas, APIs, Automações & Agentes de IA",
    description:
      "Construo o que a análise definiu. APIs robustas, produtos web e automações do zero ao deploy, incluindo agentes de IA, pipelines RAG e integrações com LLMs quando o problema pede.",
    deliverables: [
      "APIs REST com autenticação JWT/OAuth2 e documentação OpenAPI",
      "Produtos web full-stack com Python + Django + Tailwind",
      "Automações de processos e integrações com sistemas externos e webhooks",
      "Agentes de IA com ferramentas via MCP e pipelines RAG (chunking → embedding → retrieval → geração)",
      "Integração com OpenAI, Anthropic e modelos abertos, com CI/CD e deploy",
    ],
    tags: ["Python", "Django", "LangChain", "MCP"],
    primaryTag: "Python",
    cta: "Quero construir meu produto",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
    accentBorder: "border-t-2 border-t-violet-500/70",
    tagLabel: "text-violet-500 dark:text-violet-400",
    iconBg: "bg-violet-500/10 text-violet-600 dark:text-violet-400 group-hover:bg-violet-500/15",
    checkColor: "text-violet-500 dark:text-violet-400",
    tagBase: "bg-violet-500/10 border-violet-500/20 text-violet-700 dark:text-violet-400",
    tagHighlight: "bg-violet-500/20 border-violet-500/40 text-violet-700 dark:text-violet-300 font-medium",
  },
];
---

<section id="servicos" class="py-24 relative overflow-hidden">
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 h-[600px] w-[600px] rounded-full bg-primary/5 blur-3xl -z-10"
    aria-hidden="true"
  ></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div data-reveal class="text-center mb-16">
      <span
        class="inline-block rounded-full border border-border bg-muted/80 backdrop-blur-sm px-4 py-1.5 text-sm text-muted-foreground mb-4"
      >
        O que faço
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4">
        O que eu entrego
      </h2>
      <p class="text-muted-foreground text-lg max-w-xl mx-auto">
        Análise, desenvolvimento de sistemas e automação inteligente quando o problema pede.
      </p>
    </div>

    <!-- Cards -->
    <div class="grid md:grid-cols-2 gap-8">
      {
        services.map((service, i) => (
          <div
            data-reveal
            data-reveal-delay={i * 0.15}
            class={`group relative flex flex-col rounded-2xl border border-border bg-card p-8 shadow-sm transition-shadow hover:shadow-md ${service.accentBorder}`}
          >
            <!-- Tag -->
            <span class={`text-xs font-medium uppercase tracking-widest mb-6 ${service.tagLabel}`}>
              {service.tag}
            </span>

            <!-- Icon -->
            <div class={`mb-5 inline-flex h-14 w-14 items-center justify-center rounded-xl transition-colors ${service.iconBg}`}>
              <Fragment set:html={service.icon} />
            </div>

            <!-- Title + description -->
            <h3 class="text-xl font-bold mb-3">{service.title}</h3>
            <p class="text-muted-foreground leading-relaxed mb-6">
              {service.description}
            </p>

            <!-- Deliverables -->
            <ul class="space-y-2.5 mb-8 flex-1">
              {service.deliverables.map((item) => (
                <li class="flex items-start gap-2.5 text-sm">
                  <svg
                    class={`mt-0.5 h-4 w-4 shrink-0 ${service.checkColor}`}
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  <span class="text-muted-foreground">{item}</span>
                </li>
              ))}
            </ul>

            <!-- Tech tags -->
            <div class="flex flex-wrap gap-2 mb-8">
              {service.tags.map((tag) => (
                <span
                  class={`rounded-md border px-2.5 py-1 text-xs ${
                    tag === service.primaryTag ? service.tagHighlight : service.tagBase
                  }`}
                >
                  {tag}
                </span>
              ))}
            </div>

            <!-- CTA -->
            <Button as="a" href="#contato" variant="outline" class="w-full">
              {service.cta}
            </Button>
          </div>
        ))
      }
    </div>
  </div>
</section>
