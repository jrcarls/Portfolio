---
import { Button } from "@/ui/button";

const services = [
  {
    id: "ai",
    tag: "IA Generativa",
    title: "Agentes de IA & Integrações com LLMs",
    description:
      "Construo agentes, pipelines RAG e integrações com LLMs que transformam processos manuais em fluxos inteligentes — do prompt engineering à produção.",
    deliverables: [
      "Agentes de IA com ferramentas e integração via MCP",
      "Pipeline RAG completo (chunking → embedding → retrieval → geração)",
      "Integração com OpenAI, Anthropic e modelos abertos (Ollama, Llama)",
      "Avaliação e otimização de prompts para resultados consistentes",
      "Deploy com observabilidade e rastreamento de chamadas aos modelos",
    ],
    tags: ["LangChain", "OpenAI", "Anthropic", "MCP"],
    primaryTag: "LangChain",
    cta: "Quero um agente de IA",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a4 4 0 0 1 4 4c0 1.5-.83 2.82-2.04 3.53L15 12H9l1.04-2.47A4 4 0 0 1 8 6a4 4 0 0 1 4-4z"/><path d="M9 12v2a3 3 0 0 0 6 0v-2"/><path d="M6.5 17.5C5 19 5 21 5 21h14s0-2-1.5-3.5"/><path d="M12 17v4"/></svg>`,
    accentBorder: "border-t-2 border-t-indigo-500/70",
    tagLabel: "text-indigo-500 dark:text-indigo-400",
    iconBg: "bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 group-hover:bg-indigo-500/15",
    checkColor: "text-indigo-500 dark:text-indigo-400",
    tagBase: "bg-indigo-500/10 border-indigo-500/20 text-indigo-700 dark:text-indigo-400",
    tagHighlight: "bg-indigo-500/20 border-indigo-500/40 text-indigo-700 dark:text-indigo-300 font-medium",
  },
  {
    id: "dev",
    tag: "Engenharia",
    title: "APIs, Automações & Produtos Web",
    description:
      "Do backend ao produto completo. APIs robustas, automações inteligentes e aplicações web do zero ao deploy — com ou sem IA embarcada.",
    deliverables: [
      "Automações inteligentes de processos com LLMs e fluxos operacionais",
      "APIs REST com autenticação JWT/OAuth2 e documentação OpenAPI",
      "Integrações com sistemas externos e webhooks",
      "Produtos web full-stack com Python + Django + Tailwind",
      "CI/CD, testes automatizados e deploy",
    ],
    tags: ["Python", "Django", "FastAPI", "TypeScript"],
    primaryTag: "Python",
    cta: "Quero construir meu produto",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
    accentBorder: "border-t-2 border-t-primary/70",
    tagLabel: "text-primary",
    iconBg: "bg-primary/10 text-primary group-hover:bg-primary/15",
    checkColor: "text-primary",
    tagBase: "bg-primary/10 border-primary/20 text-primary",
    tagHighlight: "bg-primary/20 border-primary/40 text-primary font-medium",
  },
];
---

<section id="servicos" class="py-24 relative overflow-hidden">
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 h-[600px] w-[600px] rounded-full bg-primary/5 blur-3xl -z-10"
    aria-hidden="true"
  ></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div data-reveal class="text-center mb-16">
      <span
        class="inline-block rounded-full border border-border bg-muted px-4 py-1.5 text-sm text-muted-foreground mb-4"
      >
        O que faço
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4">
        O que eu entrego
      </h2>
      <p class="text-muted-foreground text-lg max-w-xl mx-auto">
        IA generativa e engenharia de software que trabalham juntos.
      </p>
    </div>

    <!-- Cards -->
    <div class="grid md:grid-cols-2 gap-8">
      {
        services.map((service, i) => (
          <div
            data-reveal
            data-reveal-delay={i * 0.15}
            class={`group relative flex flex-col rounded-2xl border border-border bg-card p-8 shadow-sm transition-shadow hover:shadow-md ${service.accentBorder}`}
          >
            <!-- Tag -->
            <span class={`text-xs font-medium uppercase tracking-widest mb-6 ${service.tagLabel}`}>
              {service.tag}
            </span>

            <!-- Icon -->
            <div class={`mb-5 inline-flex h-14 w-14 items-center justify-center rounded-xl transition-colors ${service.iconBg}`}>
              <Fragment set:html={service.icon} />
            </div>

            <!-- Title + description -->
            <h3 class="text-xl font-bold mb-3">{service.title}</h3>
            <p class="text-muted-foreground leading-relaxed mb-6">
              {service.description}
            </p>

            <!-- Deliverables -->
            <ul class="space-y-2.5 mb-8 flex-1">
              {service.deliverables.map((item) => (
                <li class="flex items-start gap-2.5 text-sm">
                  <svg
                    class={`mt-0.5 h-4 w-4 shrink-0 ${service.checkColor}`}
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  <span class="text-muted-foreground">{item}</span>
                </li>
              ))}
            </ul>

            <!-- Tech tags -->
            <div class="flex flex-wrap gap-2 mb-8">
              {service.tags.map((tag) => (
                <span
                  class={`rounded-md border px-2.5 py-1 text-xs ${
                    tag === service.primaryTag ? service.tagHighlight : service.tagBase
                  }`}
                >
                  {tag}
                </span>
              ))}
            </div>

            <!-- CTA -->
            <Button as="a" href="#contato" variant="outline" class="w-full">
              {service.cta}
            </Button>
          </div>
        ))
      }
    </div>
  </div>
</section>
