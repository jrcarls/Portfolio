---
const channels = [
  {
    id: "01",
    label: "WhatsApp",
    value: "+55 71 99151-6655",
    href: "https://wa.me/5571991516655?text=Olá%2C%20vim%20pelo%20site%20jeanreis.dev.br%20e%20gostaria%20de%20conversar%20sobre%20um%20projeto.",
    external: true,
    cta: "Abrir conversa",
  },
  {
    id: "02",
    label: "E-mail",
    value: "jeanreis@duck.com",
    href: "mailto:jeanreis@duck.com",
    external: false,
    cta: "Enviar e-mail",
  },
  {
    id: "03",
    label: "GitHub",
    value: "github.com/jrcarls",
    href: "https://github.com/jrcarls",
    external: true,
    cta: "Ver perfil",
  },
  {
    id: "04",
    label: "LinkedIn",
    value: "linkedin.com/in/jeanreis-dev",
    href: "https://www.linkedin.com/in/jeanreis-dev/",
    external: true,
    cta: "Conectar",
  },
];
---

<section id="contato" class="relative h-[240vh]">
  <div
    id="contact-sticky"
    class="sticky top-16 z-20 h-[calc(100dvh-4rem)] flex flex-col justify-start lg:justify-center overflow-y-auto overflow-x-hidden bg-background"
  >
    <div class="max-w-6xl mx-auto w-full px-4 sm:px-6 py-8 sm:py-10">
      <div class="mb-6 sm:mb-10">
        <h2
          class="text-2xl sm:text-4xl font-semibold uppercase tracking-[0.28em] pr-[0.28em] text-muted-foreground"
        >
          Contato
        </h2>
      </div>

      <div class="relative">
        <!-- Large reveal headline -->
        <div class="overflow-hidden mb-6 sm:mb-10">
          <p
            id="contact-headline"
            class="font-[family-name:var(--font-impact)] text-[clamp(2.2rem,8vw,5.5rem)] font-medium uppercase leading-[0.95] tracking-[-0.04em] text-foreground"
          >
            Vamos<br />conversar
          </p>
        </div>

        <p
          id="contact-lead"
          class="max-w-lg text-sm sm:text-base text-muted-foreground leading-relaxed mb-6 sm:mb-10"
        >
          Aberto para projetos, parcerias e conversas sobre sistemas.
        </p>

        <!-- Progress rail -->
        <div
          class="pointer-events-none absolute right-0 top-0 bottom-24 hidden w-px bg-border lg:block"
          aria-hidden="true"
        >
          <div
            id="contact-rail"
            class="absolute inset-x-0 top-0 h-full w-full origin-top bg-primary"
          ></div>
        </div>

        <ul
          id="contact-channels"
          class="grid grid-cols-1 sm:grid-cols-2 gap-px bg-border border border-border"
        >
          {
            channels.map((ch) => (
              <li class="contact-channel bg-card">
                <a
                  href={ch.href}
                  target={ch.external ? "_blank" : undefined}
                  rel={ch.external ? "noopener noreferrer" : undefined}
                  class="group flex h-full flex-col justify-between gap-5 sm:gap-8 p-5 sm:p-8"
                >
                  <div class="flex items-start justify-between gap-4">
                    <span class="text-xs font-semibold uppercase tracking-widest text-muted-foreground">
                      {ch.id} · {ch.label}
                    </span>
                    <span
                      aria-hidden="true"
                      class="text-muted-foreground transition-transform duration-200 group-hover:translate-x-1 group-hover:-translate-y-1 group-hover:text-primary"
                    >
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="size-5"
                      >
                        <path d="M7 17 17 7" />
                        <path d="M7 7h10v10" />
                      </svg>
                    </span>
                  </div>
                  <div>
                    <p class="text-lg sm:text-xl font-bold tracking-tight text-foreground mb-3 break-all">
                      {ch.value}
                    </p>
                    <span class="inline-flex items-center gap-2 text-sm font-medium text-muted-foreground group-hover:text-foreground transition-colors">
                      {ch.cta}
                      <span
                        aria-hidden="true"
                        class="transition-transform duration-200 group-hover:translate-x-1"
                      >
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="size-4"
                        >
                          <path d="M5 12h14" />
                          <path d="m13 6 6 6-6 6" />
                        </svg>
                      </span>
                    </span>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>

      </div>
    </div>
  </div>
</section>

<style>
  .contact-channel {
    will-change: opacity, filter, transform;
  }

  :global(html.nav-hidden) #contact-sticky {
    top: 0;
    height: 100vh;
  }

  @media (prefers-reduced-motion: reduce) {
    #contato {
      height: auto;
    }

    #contact-sticky {
      position: relative;
      top: 0;
      height: auto;
      padding-block: 6rem;
    }

    #contact-headline,
    #contact-lead,
    .contact-channel,
    #contact-rail {
      opacity: 1 !important;
      filter: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const section = document.getElementById("contato");
  const headline = document.getElementById("contact-headline");
  const lead = document.getElementById("contact-lead");
  const channels = gsap.utils.toArray<HTMLElement>(".contact-channel");
  const rail = document.getElementById("contact-rail");

  if (section && headline) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (reduced) {
      gsap.set([headline, lead, channels, rail], { clearProps: "all" });
    } else {
      gsap.set(headline, { yPercent: 110, opacity: 0 });
      gsap.set(lead, { opacity: 0, y: 28, filter: "blur(6px)" });
      gsap.set(channels, { opacity: 0.28, y: 40, filter: "blur(6px)" });
      if (rail) gsap.set(rail, { scaleY: 0, transformOrigin: "top center" });

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top top+=64",
          end: "bottom bottom",
          scrub: 0.55,
          invalidateOnRefresh: true,
        },
      });

      tl.to(
        headline,
        { yPercent: 0, opacity: 1, ease: "none", duration: 0.22 },
        0,
      )
        .to(
          lead,
          {
            opacity: 1,
            y: 0,
            filter: "blur(0px)",
            ease: "none",
            duration: 0.18,
          },
          0.12,
        )
        .to(
          channels,
          {
            opacity: 1,
            y: 0,
            filter: "blur(0px)",
            ease: "none",
            duration: 0.28,
            stagger: 0.06,
          },
          0.28,
        );

      if (rail) {
        tl.to(
          rail,
          { scaleY: 1, ease: "none", duration: 0.85 },
          0.05,
        );
      }
    }
  }
</script>
