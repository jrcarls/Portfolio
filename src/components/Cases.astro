---
const cases = [
  {
    tag: "AppSec",
    tagColor: "text-indigo-500 dark:text-indigo-400",
    borderColor: "border-t-indigo-500/70",
    iconBg: "bg-indigo-500/10 text-indigo-600 dark:text-indigo-400",
    company: "Pagora",
    segment: "Fintech · São Paulo",
    title: "Auditoria de segurança em plataforma de pagamentos",
    description:
      "Startup de pagamentos recorrentes precisava passar por due diligence de segurança antes de fechar rodada seed. A plataforma processava R$ 2M/mês sem nunca ter passado por uma auditoria formal.",
    results: [
      { label: "Vulnerabilidades críticas corrigidas", value: "3" },
      { label: "Cobertura OWASP Top 10", value: "100%" },
      { label: "Rodada seed fechada", value: "✓" },
    ],
    deliverables: [
      "Análise completa das 10 categorias OWASP",
      "2 falhas críticas de autenticação corrigidas",
      "1 vulnerabilidade de injeção SQL eliminada",
      "Relatório executivo para apresentação aos investidores",
    ],
    stack: ["OWASP", "SAST", "Burp Suite", "Python"],
    icon: `<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"><path d="M2 4.5h6.757a3 3 0 0 1 2.122.879L14 8.5m-9 5H2m6.5-6l2 2a1.414 1.414 0 1 1-2 2L7 10c-.86.86-2.223.957-3.197.227L3.5 10"/><path d="M5 11v4.5c0 1.886 0 2.828.586 3.414S7.114 19.5 9 19.5h9c1.886 0 2.828 0 3.414-.586S22 17.386 22 15.5v-3c0-1.886 0-2.828-.586-3.414S19.886 8.5 18 8.5H9.5"/><path d="M15.25 14a1.75 1.75 0 1 1-3.5 0a1.75 1.75 0 0 1 3.5 0"/></g>`,
  },
  {
    tag: "Produto Web",
    tagColor: "text-primary",
    borderColor: "border-t-primary/70",
    iconBg: "bg-primary/10 text-primary",
    company: "GestorPRO",
    segment: "SaaS B2B · Belo Horizonte",
    title: "Plataforma SaaS de gestão para clínicas",
    description:
      "Clínica de estética precisava substituir planilhas e WhatsApp por um sistema próprio. Do zero ao deploy em 10 semanas, com agendamento, prontuário digital e controle financeiro.",
    results: [
      { label: "Semanas até o primeiro deploy", value: "10" },
      { label: "Redução no tempo de agendamento", value: "70%" },
      { label: "Clínicas usando no lançamento", value: "4" },
    ],
    deliverables: [
      "Sistema completo com Django + Tailwind",
      "Autenticação multi-tenant por clínica",
      "Agendamento online com notificações por e-mail",
      "CI/CD e deploy automatizado no Railway",
    ],
    stack: ["Python", "Django", "Tailwind", "PostgreSQL", "Railway"],
    icon: `<g fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="m16 10l2.15.645c1.373.412 2.06.618 2.455 1.15c.395.53.395 1.248.395 2.681V22"/><path stroke-linecap="round" stroke-linejoin="round" d="M8 9h3m-3 4h3"/><path stroke-linejoin="round" d="M12 22v-3c0-.943 0-1.414-.293-1.707S10.943 17 10 17H9c-.943 0-1.414 0-1.707.293S7 18.057 7 19v3"/><path stroke-linecap="round" d="M2 22h20"/><path stroke-linecap="round" stroke-linejoin="round" d="M3 22V6.717c0-2.51 0-3.766.791-4.389s1.956-.284 4.287.392l5 1.451c1.406.408 2.109.612 2.515 1.169C16 5.896 16 6.653 16 8.169V22"/></g>`,
  },
  {
    tag: "API + AppSec",
    tagColor: "text-yellow-500 dark:text-yellow-400",
    borderColor: "border-t-yellow-500/70",
    iconBg: "bg-yellow-500/10 text-yellow-600 dark:text-yellow-400",
    company: "Logix",
    segment: "Logtech · Curitiba",
    title: "API segura para integração com parceiros logísticos",
    description:
      "Empresa de logística precisava expor uma API para 12 parceiros sem comprometer dados de rastreamento. A versão anterior não tinha autenticação adequada nem rate limiting.",
    results: [
      { label: "Parceiros integrados", value: "12" },
      { label: "Uptime desde o lançamento", value: "99.9%" },
      { label: "Incidentes de segurança", value: "0" },
    ],
    deliverables: [
      "API REST com autenticação OAuth2 por parceiro",
      "Rate limiting e auditoria de acessos",
      "Documentação OpenAPI completa",
      "Testes automatizados com cobertura de 85%",
    ],
    stack: ["Python", "Django REST", "OAuth2", "PostgreSQL"],
    icon: `<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.5"><path d="M21 21H10c-3.3 0-4.95 0-5.975-1.025S3 17.3 3 14V3"/><path stroke-linejoin="round" d="M7.997 16.999c3.532 0 10.915-1.464 10.7-10.566m-2.208 1.61l1.883-1.897a.497.497 0 0 1 .703-.003l1.922 1.9"/></g>`,
  },
];
---

<section id="cases" class="py-24 relative overflow-hidden">
  <div
    class="absolute top-1/2 right-0 -translate-y-1/2 h-[600px] w-[400px] rounded-full bg-primary/5 blur-[100px] -z-10"
    aria-hidden="true"
  ></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6">

    <!-- Header -->
    <div data-reveal class="text-center mb-16">
      <span class="inline-block rounded-full border border-border bg-muted px-4 py-1.5 text-sm text-muted-foreground mb-4">
        Cases
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4">
        Problemas reais, resultados concretos
      </h2>
      <p class="text-muted-foreground text-lg max-w-xl mx-auto">
        Cada projeto tem um contexto único. Veja como atuo na prática.
      </p>
    </div>

    <!-- Cards -->
    <div class="space-y-8">
      {cases.map((c, i) => (
        <div
          data-reveal
          data-reveal-delay={i * 0.1}
          class={`group rounded-2xl border border-border bg-card shadow-sm hover:shadow-md transition-shadow overflow-hidden border-t-2 ${c.borderColor}`}
        >
          <div class="grid lg:grid-cols-[1fr_280px] divide-y lg:divide-y-0 lg:divide-x divide-border">

            <!-- Conteúdo principal -->
            <div class="p-8 space-y-5">
              <div class="flex items-start gap-4">
                <div class={`shrink-0 h-12 w-12 rounded-xl flex items-center justify-center ${c.iconBg}`}>
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                    <Fragment set:html={c.icon} />
                  </svg>
                </div>
                <div>
                  <div class="flex items-center gap-2 mb-0.5">
                    <span class={`text-xs font-semibold uppercase tracking-widest ${c.tagColor}`}>{c.tag}</span>
                    <span class="text-xs text-muted-foreground">·</span>
                    <span class="text-xs text-muted-foreground">{c.segment}</span>
                  </div>
                  <h3 class="text-xl font-bold">{c.company}</h3>
                </div>
              </div>

              <p class="text-lg font-medium">{c.title}</p>
              <p class="text-muted-foreground leading-relaxed">{c.description}</p>

              <!-- Deliverables -->
              <ul class="space-y-2">
                {c.deliverables.map(item => (
                  <li class="flex items-start gap-2.5 text-sm text-muted-foreground">
                    <svg class={`mt-0.5 h-4 w-4 shrink-0 ${c.tagColor}`} xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                    {item}
                  </li>
                ))}
              </ul>

              <!-- Stack -->
              <div class="flex flex-wrap gap-2 pt-1">
                {c.stack.map(tag => (
                  <span class="rounded-md border border-border bg-muted px-2.5 py-1 text-xs text-muted-foreground">{tag}</span>
                ))}
              </div>
            </div>

            <!-- Resultados -->
            <div class="p-8 flex flex-col justify-center gap-6 bg-muted/30">
              <p class="text-xs font-semibold uppercase tracking-widest text-muted-foreground">Resultados</p>
              {c.results.map(r => (
                <div>
                  <p class={`text-3xl font-bold ${c.tagColor}`}>{r.value}</p>
                  <p class="text-sm text-muted-foreground mt-0.5">{r.label}</p>
                </div>
              ))}
            </div>

          </div>
        </div>
      ))}
    </div>

  </div>
</section>
