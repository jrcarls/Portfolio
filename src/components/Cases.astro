---
const cases = [
  {
    tag: "API + IA",
    tagColor: "text-indigo-500 dark:text-indigo-400",
    borderColor: "border-t-indigo-500/70",
    iconBg: "bg-indigo-500/10 text-indigo-600 dark:text-indigo-400",
    company: "Freire, Gerbasi & Bittencourt Advogados",
    segment: "Legaltech · Salvador",
    title: "API com integração MCP para uso com agentes de IA",
    description:
      "Desenvolvimento de uma API para o sistema de audiências do escritório com suporte nativo a MCP, permitindo integração direta com agentes de IA e LLMs. O projeto incluiu autenticação de dois fatores, autorização granular e rate limiting, entregue em 3 semanas.",
    results: [
      { label: "Semanas até a entrega", value: "3" },
      { label: "Integração MCP para LLMs", value: "✓" },
      { label: "Pronto para agentes de IA", value: "✓" },
    ],
    deliverables: [
      "API REST com autenticação de dois fatores e autorização granular",
      "Rate limiting e controle de acesso por rota",
      "Integração via MCP para uso com agentes de IA e LLMs",
      "Documentação técnica completa da API",
    ],
    stack: ["Python", "TypeScript", "PostgreSQL", "MCP"],
    icon: `<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"><path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5c0 1.1.9 2 2 2h1"/><path d="M16 3h1a2 2 0 0 1 2 2v5a2 2 0 0 0 2 2 2 2 0 0 0-2 2v5a2 2 0 0 1-2 2h-1"/></g>`,
  },
  {
    tag: "Produto Web",
    tagColor: "text-primary",
    borderColor: "border-t-primary/70",
    iconBg: "bg-primary/10 text-primary",
    company: "Esboço Online",
    segment: "SaaS B2C · Salvador",
    title: "SaaS para criação e gestão de sermões pastorais",
    description:
      "Projeto paralelo criado para atender uma necessidade real de pastores e líderes: organizar, editar e exportar sermões em um só lugar. A escolha por Nuxt e Supabase foi intencional, com olhar sistêmico de que cada tecnologia serve a um propósito diferente. Do zero ao produto funcional em 2 semanas.",
    results: [
      { label: "Exportação de sermões em PDF", value: "✓" },
      { label: "Stack enxuta e adequada ao escopo", value: "✓" },
      { label: "Projeto próprio, do zero ao ar", value: "✓" },
    ],
    deliverables: [
      "Criação, edição e armazenamento de sermões",
      "Geração e exportação de PDF por sermão",
      "Autenticação e área privada por usuário",
      "Deploy com Nuxt e Supabase sem infraestrutura própria",
    ],
    stack: ["Nuxt", "Supabase", "PostgreSQL", "TypeScript"],
    icon: `<g fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="m16 10l2.15.645c1.373.412 2.06.618 2.455 1.15c.395.53.395 1.248.395 2.681V22"/><path stroke-linecap="round" stroke-linejoin="round" d="M8 9h3m-3 4h3"/><path stroke-linejoin="round" d="M12 22v-3c0-.943 0-1.414-.293-1.707S10.943 17 10 17H9c-.943 0-1.414 0-1.707.293S7 18.057 7 19v3"/><path stroke-linecap="round" d="M2 22h20"/><path stroke-linecap="round" stroke-linejoin="round" d="M3 22V6.717c0-2.51 0-3.766.791-4.389s1.956-.284 4.287.392l5 1.451c1.406.408 2.109.612 2.515 1.169C16 5.896 16 6.653 16 8.169V22"/></g>`,
  },
];
---

<section id="cases" class="py-24 relative overflow-hidden">
  <div
    class="absolute top-1/2 right-0 -translate-y-1/2 h-[600px] w-[400px] rounded-full bg-primary/5 blur-[100px] -z-10"
    aria-hidden="true"
  ></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6">

    <!-- Header -->
    <div data-reveal class="text-center mb-16">
      <span class="inline-block rounded-full border border-border bg-muted/80 backdrop-blur-sm px-4 py-1.5 text-sm text-muted-foreground mb-4">
        Cases
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4">
        Problemas reais, resultados concretos
      </h2>
      <p class="text-muted-foreground text-lg max-w-xl mx-auto">
        Cada projeto tem um contexto único. Veja como atuo na prática.
      </p>
    </div>

    <!-- Cards -->
    <div class="space-y-8">
      {cases.map((c, i) => (
        <div
          data-reveal
          data-reveal-delay={i * 0.1}
          class={`group rounded-2xl border border-border bg-card shadow-sm hover:shadow-md transition-shadow overflow-hidden border-t-2 ${c.borderColor}`}
        >
          <div class="grid lg:grid-cols-[1fr_280px] divide-y lg:divide-y-0 lg:divide-x divide-border">

            <!-- Conteúdo principal -->
            <div class="p-8 space-y-5">
              <div class="flex items-start gap-4">
                <div class={`shrink-0 h-12 w-12 rounded-xl flex items-center justify-center ${c.iconBg}`}>
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                    <Fragment set:html={c.icon} />
                  </svg>
                </div>
                <div>
                  <div class="flex items-center gap-2 mb-0.5">
                    <span class={`text-xs font-semibold uppercase tracking-widest ${c.tagColor}`}>{c.tag}</span>
                    <span class="text-xs text-muted-foreground">·</span>
                    <span class="text-xs text-muted-foreground">{c.segment}</span>
                  </div>
                  <h3 class="text-xl font-bold">{c.company}</h3>
                </div>
              </div>

              <p class="text-lg font-medium">{c.title}</p>
              <p class="text-muted-foreground leading-relaxed">{c.description}</p>

              <!-- Deliverables -->
              <ul class="space-y-2">
                {c.deliverables.map(item => (
                  <li class="flex items-start gap-2.5 text-sm text-muted-foreground">
                    <svg class={`mt-0.5 h-4 w-4 shrink-0 ${c.tagColor}`} xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                    {item}
                  </li>
                ))}
              </ul>

              <!-- Stack -->
              <div class="flex flex-wrap gap-2 pt-1">
                {c.stack.map(tag => (
                  <span class="rounded-md border border-border bg-muted px-2.5 py-1 text-xs text-muted-foreground">{tag}</span>
                ))}
              </div>
            </div>

            <!-- Resultados -->
            <div class="p-8 flex flex-col justify-center gap-6 bg-muted/30">
              <p class="text-xs font-semibold uppercase tracking-widest text-muted-foreground">Resultados</p>
              {c.results.map(r => (
                <div>
                  <p class={`text-3xl font-bold ${c.tagColor}`}>{r.value}</p>
                  <p class="text-sm text-muted-foreground mt-0.5">{r.label}</p>
                </div>
              ))}
            </div>

          </div>
        </div>
      ))}
    </div>

  </div>
</section>
