---

<section id="hero" class="relative h-[200vh]">
  <div
    id="hero-sticky"
    class="sticky top-0 h-screen flex flex-col overflow-hidden"
  >
  <div
    class="relative z-10 flex flex-1 flex-col w-full max-w-6xl mx-auto px-4 sm:px-6 pt-24 sm:pt-14 pb-6"
  >
    <div id="hero-heading" class="order-1 flex flex-col items-center gap-2 sm:gap-3">
      <h1
        id="hero-title"
        class="whitespace-nowrap text-center font-[family-name:var(--font-impact)] text-[clamp(2.5rem,12vw,10rem)] font-medium uppercase leading-[0.86] tracking-[-0.04em] text-foreground opacity-0 origin-center will-change-transform"
      >
        Jean Reis
      </h1>
      <p
        id="hero-subtitle"
        class="text-center text-sm sm:text-base md:text-lg font-medium tracking-[0.2em] uppercase text-muted-foreground opacity-0"
      >
        Engenheiro de Software
      </p>
    </div>

    <div
      class="order-2 mt-2 lg:mt-0 grid flex-1 grid-cols-1 lg:grid-cols-2 lg:items-center gap-8 lg:gap-6"
    >
      <div
        id="hero-copy"
        class="mt-6 sm:mt-0 space-y-10 text-center lg:text-left max-w-sm mx-auto lg:mx-0 lg:self-center opacity-0"
      >
        <p class="text-base sm:text-lg text-foreground/80 leading-relaxed">
          Olá! Sou analista e desenvolvedor de sistemas. Projeto APIs, produtos web e automações sob medida — incluindo IA quando o problema pede.
        </p>
        <a
          id="hero-cta"
          href="https://wa.me/5571991516655?text=Olá%2C%20vim%20pelo%20site%20jeanreis.dev.br%20e%20gostaria%20de%20conversar%20sobre%20um%20projeto."
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-2 text-sm font-semibold tracking-[0.14em] uppercase text-foreground hover:text-primary transition-colors"
        >
          // Fale comigo
          <span
            aria-hidden="true"
            class="transition-transform duration-200 group-hover:translate-x-1"
          >→</span>
        </a>
      </div>

      <ul
        id="hero-services"
        class="space-y-2.5 text-center lg:text-right opacity-0"
      >
        {
          services.map((service) => (
            <li>
              <a
                href={service.href}
                class:list={[
                  "inline-block text-base sm:text-lg transition-colors",
                  service.active
                    ? "text-foreground font-medium"
                    : "text-muted-foreground/55 hover:text-muted-foreground",
                ]}
              >
                {service.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

  </div>

  <div id="hero-brands" class="order-3 mt-auto w-full pt-8 lg:pt-4 pb-4 opacity-0">
    <Marquee time={35} class="py-2">
      {
        brands.map((brand) => (
          <div class="mx-8 flex items-center gap-2 text-muted-foreground/70">
            <span class="opacity-80">
              <Fragment set:html={brand.icon} />
            </span>
            <span class="text-sm font-medium tracking-tight whitespace-nowrap">{brand.name}</span>
          </div>
        ))
      }
    </Marquee>
  </div>
  </div>
</section>

<script>
  import { animate } from "motion";
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  animate("#hero-title", { opacity: [0, 1], y: [-28, 0] }, { duration: 0.7, delay: 0.15, easing: [0.22, 1, 0.36, 1] });
  animate("#hero-subtitle", { opacity: [0, 1], y: [12, 0] }, { duration: 0.55, delay: 0.28, easing: "ease-out" });
  animate("#hero-copy", { opacity: [0, 1], y: [16, 0] }, { duration: 0.55, delay: 0.35, easing: "ease-out" });
  animate("#hero-services", { opacity: [0, 1], y: [16, 0] }, { duration: 0.55, delay: 0.45, easing: "ease-out" });
  animate("#hero-brands", { opacity: [0, 1] }, { duration: 0.55, delay: 0.6, easing: "ease-out" });

  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const hero = document.getElementById("hero");
    if (hero) {
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: hero,
          start: "top top",
          end: "bottom top",
          scrub: 0.6,
          invalidateOnRefresh: true,
        },
      });

      // fromTo explícito: ao voltar o scroll, restaura sempre o estado visível
      tl.fromTo(
        "#hero-title",
        { scale: 1, y: 0, opacity: 1 },
        { scale: 1.12, y: -48, opacity: 0, ease: "none", immediateRender: false },
        0,
      )
        .fromTo(
          "#hero-subtitle",
          { y: 0, opacity: 1 },
          { y: -24, opacity: 0, ease: "none", immediateRender: false },
          0,
        )
        .fromTo(
          "#hero-copy",
          { x: 0, y: 0, opacity: 1, filter: "blur(0px)" },
          {
            x: -80,
            y: 24,
            opacity: 0,
            filter: "blur(12px)",
            ease: "none",
            immediateRender: false,
          },
          0,
        )
        .fromTo(
          "#hero-services",
          { x: 0, y: 0, opacity: 1, filter: "blur(0px)" },
          {
            x: 80,
            y: 24,
            opacity: 0,
            filter: "blur(12px)",
            ease: "none",
            immediateRender: false,
          },
          0,
        )
        .fromTo(
          "#hero-brands",
          { y: 0, opacity: 1, filter: "blur(0px)" },
          {
            y: 40,
            opacity: 0,
            filter: "blur(8px)",
            ease: "none",
            immediateRender: false,
          },
          0.05,
        );
    }
  }
</script>
