---
import { Button } from "@/ui/button";
---

<section
  id="hero"
  class="relative min-h-[calc(100vh-4rem)] flex items-center overflow-hidden"
>
  <!-- Background -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <!-- Blobs -->
    <div
      id="blob-1"
      class="absolute -top-48 -right-24 h-[560px] w-[560px] rounded-full bg-primary/20 blur-[100px]"
    ></div>
    <div
      id="blob-2"
      class="absolute -bottom-40 -left-24 h-[480px] w-[480px] rounded-full bg-primary/15 blur-[80px]"
    ></div>
    <div
      id="blob-3"
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 h-[300px] w-[300px] rounded-full bg-primary/8 blur-[60px]"
    ></div>
    <!-- Grid -->
    <svg class="absolute inset-0 h-full w-full opacity-[0.035]" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="hero-grid" width="48" height="48" patternUnits="userSpaceOnUse">
          <path d="M 48 0 L 0 0 0 48" fill="none" stroke="currentColor" stroke-width="1"></path>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hero-grid)"></rect>
    </svg>
    <!-- Dot center -->
    <svg class="absolute inset-0 h-full w-full opacity-[0.025]" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="hero-dots" width="48" height="48" patternUnits="userSpaceOnUse">
          <circle cx="24" cy="24" r="1" fill="currentColor"></circle>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hero-dots)"></rect>
    </svg>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-20 w-full">
    <div class="grid lg:grid-cols-2 gap-12 items-center">

      <!-- Conteúdo -->
      <div class="space-y-7 text-center lg:text-left">

        <div
          id="hero-badge"
          class="inline-flex items-center gap-2 rounded-full border border-border bg-muted/80 backdrop-blur-sm px-4 py-1.5 text-sm text-muted-foreground opacity-0"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-primary animate-pulse"></span>
          Engenharia de software · Web · Solo dev
        </div>

        <h1
          id="hero-title"
          class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.1] opacity-0"
        >
          Software <span class="text-primary relative">sob medida
            <span
              id="hero-underline"
              class="absolute -bottom-1 left-0 h-[3px] w-0 rounded-full bg-primary"
            ></span>
          </span>
          <br />para o seu negócio.
        </h1>

        <p
          id="hero-subtitle"
          class="text-lg text-muted-foreground max-w-lg leading-relaxed opacity-0 mx-auto lg:mx-0"
        >
          Na Ovelha Tech, transformo ideias complexas em aplicações web
          eficientes, seguras e prontas para escalar.
        </p>

        <div
          id="hero-bio"
          class="opacity-0 border-l-2 border-primary pl-4 text-sm text-muted-foreground leading-relaxed max-w-md mx-auto lg:mx-0"
        >
          Muito prazer, sou o fundador e a mente técnica por trás da Ovelha Tech.
          Como desenvolvedor solo, uno a robustez de uma agência com a agilidade e
          o atendimento direto de um especialista. Você lida diretamente com quem
          escreve o código.
        </div>

        <div id="hero-ctas" class="flex flex-wrap justify-center lg:justify-start gap-3 opacity-0">
          <Button as="a" href="#contato" size="lg">
            Quero um diagnóstico gratuito
          </Button>
          <Button as="a" href="#servicos" variant="outline" size="lg">
            Ver serviços
          </Button>
        </div>

        <!-- Indicadores -->
        <div id="hero-stats" class="flex items-center justify-center lg:justify-start gap-6 pt-2 opacity-0">
          <div class="text-center">
            <p class="text-2xl font-bold text-foreground">5+</p>
            <p class="text-xs text-muted-foreground">Projetos entregues</p>
          </div>
          <div class="w-px h-8 bg-border"></div>
          <div class="text-center">
            <p class="text-2xl font-bold text-foreground">25+</p>
            <p class="text-xs text-muted-foreground">Vulnerabilidades corrigidas</p>
          </div>
          <div class="w-px h-8 bg-border"></div>
          <div class="text-center">
            <p class="text-2xl font-bold text-foreground">100%</p>
            <p class="text-xs text-muted-foreground">Atendimento direto</p>
          </div>
        </div>
      </div>

      <!-- Visual -->
      <div
        id="hero-visual"
        class="hidden lg:flex justify-center items-center opacity-0"
      >
        <!-- Container de tamanho fixo para posicionamento absoluto -->
        <div class="relative w-[480px] h-[480px]">

          <!-- Anéis decorativos -->
          <div
            id="ring-outer"
            class="absolute rounded-full border border-primary/15 border-dashed"
            style="width:420px;height:420px;top:50%;left:50%;transform:translate(-50%,-50%)"
          ></div>
          <div
            id="ring-mid"
            class="absolute rounded-full border border-primary/20"
            style="width:320px;height:320px;top:50%;left:50%;transform:translate(-50%,-50%)"
          ></div>

          <!-- Card da ovelha -->
          <div
            id="hero-card"
            class="absolute z-10 rounded-full border border-border bg-card/80 backdrop-blur-sm shadow-2xl overflow-hidden"
            style="width:240px;height:240px;top:50%;left:50%;transform:translate(-50%,-50%)"
          >
            <div class="absolute inset-0 bg-gradient-to-br from-primary/10 via-transparent to-primary/5"></div>
            <img src="/ovelha_tech_bg.svg" alt="Ovelha Tech" class="w-full h-full object-cover" />
          </div>

          <!--
            Braços de órbita: cada braço tem origin no centro do container.
            O badge fica a ~190px do centro (borda da órbita).
            O badge interno contra-rotaciona para ficar sempre legível.
          -->

          <!-- Braço 1 — começa em 0° (direita) -->
          <div
            id="arm-1"
            class="absolute"
            style="top:50%;left:50%;width:0;height:0;transform-origin:0 0;transform:rotate(0deg)"
          >
            <div
              id="badge-stack"
              class="absolute opacity-0 rounded-xl border border-border bg-card px-3 py-2 shadow-lg flex items-center gap-2 whitespace-nowrap"
              style="left:170px;top:0;transform:translateY(-50%)"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" class="text-primary shrink-0"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m9.5 9.5l-1.533 1.322C7.322 11.377 7 11.655 7 12s.322.623.967 1.178L9.5 14.5m5-5l1.533 1.322c.645.555.967.833.967 1.178s-.322.623-.967 1.178L14.5 14.5"/></g></svg>
              <div>
                <p class="text-xs text-muted-foreground">Stack moderno</p>
                <p class="text-sm font-semibold">Python · Django · Tailwind</p>
              </div>
            </div>
          </div>

          <!-- Braço 2 — começa em 120° -->
          <div
            id="arm-2"
            class="absolute"
            style="top:50%;left:50%;width:0;height:0;transform-origin:0 0;transform:rotate(120deg)"
          >
            <div
              id="badge-sec"
              class="absolute opacity-0 rounded-xl border border-border bg-card px-3 py-2 shadow-lg flex items-center gap-2 whitespace-nowrap"
              style="left:170px;top:0;transform:translateY(-50%)"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" class="text-primary shrink-0"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18.709 3.495C16.817 2.554 14.5 2 12 2s-4.816.554-6.709 1.495c-.928.462-1.392.693-1.841 1.419S3 6.342 3 7.748v3.49c0 5.683 4.542 8.842 7.173 10.196c.734.377 1.1.566 1.827.566s1.093-.189 1.827-.566C16.457 20.08 21 16.92 21 11.237V7.748c0-1.406 0-2.108-.45-2.834s-.913-.957-1.841-1.419"/></svg>
              <div>
                <p class="text-xs text-muted-foreground">Segurança integrada</p>
                <p class="text-sm font-semibold">AppSec first</p>
              </div>
            </div>
          </div>

          <!-- Braço 3 — começa em 240° -->
          <div
            id="arm-3"
            class="absolute"
            style="top:50%;left:50%;width:0;height:0;transform-origin:0 0;transform:rotate(240deg)"
          >
            <div
              id="badge-ship"
              class="absolute opacity-0 rounded-xl border border-border bg-card px-3 py-2 shadow-lg flex items-center gap-2 whitespace-nowrap"
              style="left:170px;top:0;transform:translateY(-50%)"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" class="text-primary shrink-0"><g fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linejoin="round" d="m11.801 6.49l1.486-1.486c1.673-1.673 3.862-2.367 6.18-2.48c.902-.044 1.352-.066 1.714.295c.361.362.34.812.295 1.714c-.113 2.318-.807 4.507-2.48 6.18L17.511 12.2c-1.224 1.223-1.572 1.571-1.315 2.898c.254 1.014.499 1.995-.238 2.732c-.894.895-1.71.895-2.604 0l-7.183-7.183c-.895-.894-.895-1.71 0-2.604c.737-.737 1.718-.492 2.732-.238c1.327.257 1.675-.091 2.898-1.315Z"/><path stroke-linecap="round" d="m2.5 21.5l5-5m1 5l2-2m-8-4l2-2"/><path stroke-linecap="round" stroke-linejoin="round" d="M17.125 7H17m.25 0a.25.25 0 1 1-.5 0a.25.25 0 0 1 .5 0"/></g></svg>
              <div>
                <p class="text-xs text-muted-foreground">Do código ao</p>
                <p class="text-sm font-semibold">deploy</p>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  import { animate } from "motion";

  // Texto — entrada escalonada
  animate("#hero-badge",    { opacity: [0, 1], y: [-16, 0] }, { duration: 0.5, delay: 0.1,  easing: "ease-out" });
  animate("#hero-title",    { opacity: [0, 1], y: [-24, 0] }, { duration: 0.6, delay: 0.25, easing: "ease-out" });
  animate("#hero-subtitle", { opacity: [0, 1], y: [-16, 0] }, { duration: 0.5, delay: 0.4,  easing: "ease-out" });
  animate("#hero-bio",      { opacity: [0, 1], y: [-12, 0] }, { duration: 0.5, delay: 0.55, easing: "ease-out" });
  animate("#hero-ctas",     { opacity: [0, 1], y: [-12, 0] }, { duration: 0.5, delay: 0.7,  easing: "ease-out" });
  animate("#hero-stats",    { opacity: [0, 1], y: [-8,  0] }, { duration: 0.5, delay: 0.85, easing: "ease-out" });

  // Sublinhado animado no título
  animate("#hero-underline", { width: ["0%", "100%"] }, { duration: 0.6, delay: 0.9, easing: [0.25, 0.1, 0.25, 1] });

  // Visual — entra da direita
  animate("#hero-visual", { opacity: [0, 1], x: [40, 0] }, { duration: 0.7, delay: 0.4, easing: "ease-out" });

  // Badges — fade in antes de começar a orbitar
  animate("#badge-stack", { opacity: [0, 1] }, { duration: 0.4, delay: 1.0, easing: "ease-out" });
  animate("#badge-sec",   { opacity: [0, 1] }, { duration: 0.4, delay: 1.15, easing: "ease-out" });
  animate("#badge-ship",  { opacity: [0, 1] }, { duration: 0.4, delay: 1.3,  easing: "ease-out" });

  // Blobs flutuando
  animate("#blob-1", { y: [-40, 40] }, { duration: 7, repeat: Infinity, repeatType: "reverse", easing: "ease-in-out" });
  animate("#blob-2", { y: [40, -40] }, { duration: 9, repeat: Infinity, repeatType: "reverse", easing: "ease-in-out" });
  animate("#blob-3", { scale: [1, 1.2] }, { duration: 5, repeat: Infinity, repeatType: "reverse", easing: "ease-in-out" });

  // Anéis decorativos girando
  animate("#ring-outer", { rotate: [0, 360] },  { duration: 30, repeat: Infinity, easing: "linear" });
  animate("#ring-mid",   { rotate: [0, -360] }, { duration: 20, repeat: Infinity, easing: "linear" });

  // Órbita dos braços (sentido horário, 18s por volta)
  const orbitDuration = 45;
  animate("#arm-1", { rotate: [0,   360] }, { duration: orbitDuration, repeat: Infinity, easing: "linear" });
  animate("#arm-2", { rotate: [120, 480] }, { duration: orbitDuration, repeat: Infinity, easing: "linear" });
  animate("#arm-3", { rotate: [240, 600] }, { duration: orbitDuration, repeat: Infinity, easing: "linear" });

  // Contra-rotação dos badges para texto sempre legível
  animate("#badge-stack", { rotate: [0,   -360] }, { duration: orbitDuration, repeat: Infinity, easing: "linear" });
  animate("#badge-sec",   { rotate: [-120, -480] }, { duration: orbitDuration, repeat: Infinity, easing: "linear" });
  animate("#badge-ship",  { rotate: [-240, -600] }, { duration: orbitDuration, repeat: Infinity, easing: "linear" });
</script>
