---
import {
  NavigationMenu,
  NavigationMenuList,
  NavigationMenuItem,
  NavigationMenuLink,
  navigationMenuTriggerStyle,
} from "@/ui/navigation-menu";
import { Button } from "@/ui/button";
import ThemeToggle from "@/components/ThemeToggle.astro";

const linkClass = navigationMenuTriggerStyle();
---

<div
  id="scroll-progress"
  class="fixed top-0 left-0 z-60 h-[2px] w-0 bg-primary origin-left transition-transform duration-300"
  aria-hidden="true"
></div>

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-[color,background-color,border-color,transform] duration-300 opacity-0"
>
  <div
    class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between"
  >
    <a id="navbar-logo" href="/" class="flex items-center gap-2 text-xl tracking-tight opacity-0 font-[family-name:var(--font-logo)]">
      jeanreis.dev.br
    </a>

    <nav id="navbar-links" class="hidden md:block opacity-0">
      <NavigationMenu>
        <NavigationMenuList>
          <NavigationMenuItem>
            <NavigationMenuLink href="#skills" class={linkClass}>Skills</NavigationMenuLink>
          </NavigationMenuItem>
          <NavigationMenuItem>
            <NavigationMenuLink href="#cases" class={linkClass}>Cases</NavigationMenuLink>
          </NavigationMenuItem>
          <NavigationMenuItem>
            <NavigationMenuLink href="#sobre" class={linkClass}>Sobre</NavigationMenuLink>
          </NavigationMenuItem>
          <NavigationMenuItem>
            <NavigationMenuLink href="#faq" class={linkClass}>FAQ</NavigationMenuLink>
          </NavigationMenuItem>
          <NavigationMenuItem>
            <NavigationMenuLink href="#contato" class={linkClass}>Contato</NavigationMenuLink>
          </NavigationMenuItem>
        </NavigationMenuList>
      </NavigationMenu>
    </nav>

    <div id="navbar-cta" class="flex items-center gap-2 opacity-0">
      <span class="hidden lg:inline-flex items-center gap-2 pr-2 text-sm text-foreground/80">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-60"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
        </span>
        Aberto para projetos
      </span>
      <ThemeToggle />
      <Button as="a" href="#contato" class="hidden md:inline-flex">Entre em contato</Button>
      <button
        id="menu-toggle"
        class="md:hidden inline-flex items-center justify-center rounded-md p-2 text-foreground hover:bg-accent transition-colors"
        aria-label="Abrir menu"
        aria-expanded="false"
      >
        <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/>
        </svg>
        <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden border-t border-border bg-background/95 backdrop-blur-sm"
  >
    <nav class="max-w-6xl mx-auto px-4 py-4 flex flex-col gap-1">
      <a data-mobile-index="0" href="#skills" class="mobile-link rounded-md px-3 py-2.5 text-sm font-medium hover:bg-accent transition-colors">Skills</a>
      <a data-mobile-index="1" href="#cases" class="mobile-link rounded-md px-3 py-2.5 text-sm font-medium hover:bg-accent transition-colors">Cases</a>
      <a data-mobile-index="2" href="#sobre" class="mobile-link rounded-md px-3 py-2.5 text-sm font-medium hover:bg-accent transition-colors">Sobre</a>
      <a data-mobile-index="3" href="#faq" class="mobile-link rounded-md px-3 py-2.5 text-sm font-medium hover:bg-accent transition-colors">FAQ</a>
      <a data-mobile-index="4" href="#contato" class="mobile-link rounded-md px-3 py-2.5 text-sm font-medium hover:bg-accent transition-colors">Contato</a>
      <div class="pt-2 border-t border-border mt-1">
        <Button as="a" href="#contato" class="w-full">Entre em contato</Button>
      </div>
    </nav>
  </div>
</header>

<!-- Scrim: foca a atenção no menu mobile ao abrir, desfocando o conteúdo abaixo -->
<div
  id="mobile-menu-scrim"
  class="md:hidden hidden fixed inset-0 top-16 z-40 bg-background/40 backdrop-blur-sm"
  aria-hidden="true"
></div>

<script>
  // @ts-nocheck
  import { animate, stagger, scroll } from "motion";

  const navbar = document.getElementById("navbar");
  const logo = document.getElementById("navbar-logo");
  const links = document.getElementById("navbar-links");
  const cta = document.getElementById("navbar-cta");

  // entrada: header desliza de cima + fade
  animate(
    navbar! as Element,
    { opacity: [0, 1], y: [-20, 0] },
    { duration: 0.5, easing: "ease-out" },
  );

  // logo, links e CTA entram em sequência com stagger
  animate(
    [logo!, links!, cta!] as Element[],
    { opacity: [0, 1], y: [-8, 0] },
    { duration: 0.4, delay: stagger(0.1, { startDelay: 0.25 }), easing: "ease-out" },
  );

  // barra de progresso de scroll
  const progressBar = document.getElementById("scroll-progress");
  if (progressBar) {
    scroll((progress) => {
      progressBar.style.width = `${progress * 100}%`;
    });
  }

  // menu mobile
  const menuToggle = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const menuScrim = document.getElementById("mobile-menu-scrim");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");
  const mobileLinks = document.querySelectorAll(".mobile-link");

  const closeMobileMenu = () => {
    animate("#mobile-menu", { opacity: [1, 0], y: [0, -8] }, { duration: 0.2, easing: "ease-in" }).then(() => {
      mobileMenu?.classList.add("hidden");
    });
    animate("#mobile-menu-scrim", { opacity: [1, 0] }, { duration: 0.2, easing: "ease-in" }).then(() => {
      menuScrim?.classList.add("hidden");
    });
    iconOpen?.classList.remove("hidden");
    iconClose?.classList.add("hidden");
    menuToggle?.setAttribute("aria-expanded", "false");
  };

  menuToggle?.addEventListener("click", () => {
    const isOpen = !mobileMenu?.classList.contains("hidden");
    if (isOpen) {
      closeMobileMenu();
    } else {
      mobileMenu?.classList.remove("hidden");
      menuScrim?.classList.remove("hidden");
      animate("#mobile-menu", { opacity: [0, 1], y: [-8, 0] }, { duration: 0.25, easing: "ease-out" });
      animate("#mobile-menu-scrim", { opacity: [0, 1] }, { duration: 0.25, easing: "ease-out" });
      for (let i = 0; i < 5; i++) {
        animate(`[data-mobile-index="${i}"]`, { opacity: [0, 1], x: [-10, 0] }, { duration: 0.2, delay: 0.05 + i * 0.05, easing: "ease-out" });
      }
      iconOpen?.classList.add("hidden");
      iconClose?.classList.remove("hidden");
      menuToggle.setAttribute("aria-expanded", "true");
    }
  });

  menuScrim?.addEventListener("click", closeMobileMenu);

  mobileLinks.forEach((link) => {
    link.addEventListener("click", closeMobileMenu);
  });

  // scroll: fundo sólido + esconde ao descer / mostra ao subir
  if (navbar) {
    let lastY = window.scrollY;
    let hidden = false;

    const setHidden = (next) => {
      if (hidden === next) return;
      hidden = next;
      const y = next ? "-100%" : "0";
      navbar.style.transform = `translateY(${y})`;
      if (progressBar) progressBar.style.transform = `translateY(${y})`;
      document.documentElement.classList.toggle("nav-hidden", next);
    };

    const update = () => {
      const y = window.scrollY;
      if (y > 10) {
        navbar.classList.add("bg-background/95", "backdrop-blur-sm", "border-b");
      } else {
        navbar.classList.remove(
          "bg-background/95",
          "backdrop-blur-sm",
          "border-b",
        );
      }

      const menuOpen = !mobileMenu?.classList.contains("hidden");
      if (menuOpen || y < 80) {
        setHidden(false);
        lastY = y;
        return;
      }

      if (y - lastY > 8) setHidden(true);
      else if (lastY - y > 8) setHidden(false);
      lastY = y;
    };
    window.addEventListener("scroll", update, { passive: true });
    update();
  }
</script>
