---
import ThemeToggle from "@/components/ThemeToggle.astro";

const links = [
  { href: "#hero", label: "Intro" },
  { href: "#projetos", label: "Projetos" },
  { href: "#skills", label: "Skills" },
  { href: "#experiencias", label: "Experiências" },
  { href: "#sobre", label: "Sobre" },
  { href: "#contato", label: "Contato" },
];
---

<div
  id="scroll-progress"
  class="fixed top-0 left-0 z-[70] h-[2px] w-0 bg-primary origin-left"
  aria-hidden="true"
></div>

<header id="navbar" class="fixed inset-x-0 top-0 z-50 pointer-events-none opacity-0">
  <div class="flex items-start justify-between gap-4 p-4 sm:p-6">
    <a
      id="navbar-logo"
      href="/"
      class="pointer-events-auto inline-flex items-center rounded-full border border-white/15 bg-black/35 px-4 py-2 text-sm tracking-tight text-white backdrop-blur-md opacity-0 font-[family-name:var(--font-logo)] hover:bg-black/50 transition-colors"
    >
      jeanreis.dev.br
    </a>

    <div id="navbar-actions" class="pointer-events-auto flex items-center gap-2 opacity-0">
      <div class="rounded-full border border-white/15 bg-black/35 backdrop-blur-md">
        <ThemeToggle />
      </div>
      <button
        id="menu-toggle"
        type="button"
        class="inline-flex h-11 items-center justify-center rounded-full border border-white/15 bg-black/35 px-5 text-sm font-medium tracking-[0.14em] uppercase text-white backdrop-blur-md transition-colors hover:bg-black/50"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls="site-menu"
      >
        <span id="menu-toggle-label">Menu</span>
      </button>
    </div>
  </div>
</header>

<div
  id="site-menu"
  class="fixed inset-0 z-[60] hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Menu de navegação"
>
  <div id="site-menu-scrim" class="absolute inset-0 bg-black/55 backdrop-blur-md"></div>

  <div class="relative z-10 flex h-full flex-col px-6 py-6 sm:px-10 sm:py-8">
    <div class="flex items-start justify-between gap-4">
      <a
        href="/"
        class="inline-flex items-center rounded-full border border-white/15 bg-white/10 px-4 py-2 text-sm tracking-tight text-white backdrop-blur-md font-[family-name:var(--font-logo)]"
      >
        jeanreis.dev.br
      </a>
      <button
        id="menu-close"
        type="button"
        class="inline-flex h-11 items-center justify-center rounded-full border border-white/15 bg-white/10 px-5 text-sm font-medium tracking-[0.14em] uppercase text-white backdrop-blur-md transition-colors hover:bg-white/15"
      >
        Close
      </button>
    </div>

    <nav class="flex flex-1 flex-col items-center justify-center gap-2 sm:gap-3">
      {
        links.map((link, i) => (
          <a
            href={link.href}
            data-menu-link
            data-menu-index={i}
            class="menu-link text-center font-[family-name:var(--font-impact)] text-[clamp(2rem,8vw,4.5rem)] font-black uppercase leading-none tracking-[-0.03em] text-white/90 transition-colors hover:text-primary"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex flex-col items-center gap-3 pb-4 text-center sm:flex-row sm:justify-between sm:text-left">
      <p class="text-xs tracking-[0.18em] uppercase text-white/50">
        Aberto para projetos
      </p>
      <a
        href="https://wa.me/5571991516655?text=Olá%2C%20vim%20pelo%20site%20jeanreis.dev.br%20e%20gostaria%20de%20conversar%20sobre%20um%20projeto."
        target="_blank"
        rel="noopener noreferrer"
        data-menu-link
        class="text-sm font-medium tracking-[0.14em] uppercase text-white/80 transition-colors hover:text-primary"
      >
        Fale comigo →
      </a>
    </div>
  </div>
</div>

<script>
  // @ts-nocheck
  import { animate, stagger, scroll } from "motion";

  const navbar = document.getElementById("navbar");
  const logo = document.getElementById("navbar-logo");
  const actions = document.getElementById("navbar-actions");
  const menu = document.getElementById("site-menu");
  const menuToggle = document.getElementById("menu-toggle");
  const menuClose = document.getElementById("menu-close");
  const menuLabel = document.getElementById("menu-toggle-label");
  const menuLinks = document.querySelectorAll("[data-menu-link]");
  const progressBar = document.getElementById("scroll-progress");

  animate(navbar, { opacity: [0, 1], y: [-16, 0] }, { duration: 0.5, easing: "ease-out" });
  animate(
    [logo, actions],
    { opacity: [0, 1], y: [-8, 0] },
    { duration: 0.4, delay: stagger(0.08, { startDelay: 0.2 }), easing: "ease-out" },
  );

  if (progressBar) {
    scroll((progress) => {
      progressBar.style.width = `${progress * 100}%`;
    });
  }

  let menuOpen = false;

  const setMenuOpen = (open) => {
    if (menuOpen === open) return;
    menuOpen = open;

    menuToggle?.setAttribute("aria-expanded", String(open));
    if (menuLabel) menuLabel.textContent = open ? "Close" : "Menu";
    document.documentElement.classList.toggle("menu-open", open);
    document.body.style.overflow = open ? "hidden" : "";

    if (open) {
      menu?.classList.remove("hidden");
      animate("#site-menu-scrim", { opacity: [0, 1] }, { duration: 0.3, easing: "ease-out" });
      animate(
        ".menu-link",
        { opacity: [0, 1], y: [24, 0] },
        { duration: 0.45, delay: stagger(0.05, { startDelay: 0.08 }), easing: [0.22, 1, 0.36, 1] },
      );
    } else {
      animate("#site-menu-scrim", { opacity: [1, 0] }, { duration: 0.25, easing: "ease-in" });
      animate(
        ".menu-link",
        { opacity: [1, 0], y: [0, -12] },
        { duration: 0.2, easing: "ease-in" },
      ).then(() => {
        menu?.classList.add("hidden");
      });
    }
  };

  menuToggle?.addEventListener("click", () => setMenuOpen(!menuOpen));
  menuClose?.addEventListener("click", () => setMenuOpen(false));
  document.getElementById("site-menu-scrim")?.addEventListener("click", () => setMenuOpen(false));

  menuLinks.forEach((link) => {
    link.addEventListener("click", () => setMenuOpen(false));
  });

  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menuOpen) setMenuOpen(false);
  });
</script>

<style>
  :global(html.menu-open) {
    overflow: hidden;
  }

  :global(html.menu-open) #navbar {
    opacity: 0 !important;
    pointer-events: none !important;
  }
</style>
