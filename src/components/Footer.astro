---
const nav = [
  { href: "#hero", label: "Intro" },
  { href: "#projetos", label: "Projetos" },
  { href: "#skills", label: "Skills" },
  { href: "#experiencias", label: "Experiências" },
  { href: "#sobre", label: "Sobre" },
  { href: "#contato", label: "Contato" },
];

const socials = [
  {
    label: "WhatsApp",
    href: "https://wa.me/5571991516655?text=Olá%2C%20vim%20pelo%20site%20jeanreis.dev.br%20e%20gostaria%20de%20conversar%20sobre%20um%20projeto.",
  },
  { label: "E-mail", href: "mailto:contato@jeanreis.dev.br" },
  { label: "GitHub", href: "https://github.com/jrcarls" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/jeanreis-dev/" },
];

const year = new Date().getFullYear();
---

<footer
  id="site-footer"
  class="pointer-events-none fixed inset-x-0 bottom-0 z-0 flex h-[min(92dvh,48rem)] sm:h-[min(68vh,36rem)] items-end overflow-hidden"
  aria-label="Rodapé"
>
  <div
    id="footer-panel"
    class="pointer-events-auto mx-auto flex h-full w-full max-w-6xl flex-col justify-between px-4 py-6 sm:px-6 sm:py-14"
  >
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-md">
        <p
          id="footer-kicker"
          class="text-xs font-semibold uppercase tracking-[0.28em] text-muted-foreground"
        >
          Jean Reis
        </p>
        <p
          id="footer-lead"
          class="mt-4 text-sm sm:text-base leading-relaxed text-muted-foreground"
        >
          Produtos digitais marcantes, com foco na experiência do usuário.
        </p>
        <a
          id="footer-cta"
          href="#contato"
          class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-foreground transition-colors hover:text-primary"
        >
          Vamos conversar
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="grid grid-cols-2 gap-10 sm:gap-16">
        <div>
          <p
            class="mb-4 text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground/70"
          >
            Navegação
          </p>
          <ul id="footer-nav" class="space-y-2.5">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="footer-link text-sm text-muted-foreground transition-colors hover:text-foreground"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p
            class="mb-4 text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground/70"
          >
            Contato
          </p>
          <ul id="footer-socials" class="space-y-2.5">
            {
              socials.map((item) => (
                <li>
                  <a
                    href={item.href}
                    target={item.href.startsWith("http") ? "_blank" : undefined}
                    rel={item.href.startsWith("http") ? "noopener noreferrer" : undefined}
                    class="footer-link text-sm text-muted-foreground transition-colors hover:text-foreground"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <div>
      <p
        id="footer-wordmark"
        class="py-3 sm:py-0 font-[family-name:var(--font-impact)] text-[clamp(2.8rem,14vw,8.5rem)] font-medium uppercase leading-[0.85] tracking-[-0.05em] text-foreground"
      >
        jeanreis
      </p>
      <div
        id="footer-meta"
        class="mt-6 grid gap-2 border-t border-border pt-5 text-center sm:grid-cols-[1fr_auto_1fr] sm:items-center sm:text-left"
      >
        <p class="text-xs text-muted-foreground/70">
          “Daria tudo que sei pela metade do que ignoro.”
        </p>
        <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground/70 sm:text-center">
          Colossenses 3:23
        </p>
        <p class="text-xs text-muted-foreground/60 sm:justify-self-end">
          © {year} Jean Reis
        </p>
      </div>
    </div>
  </div>
</footer>

<!-- Spacer so the last scroll distance equals the footer height -->
<div id="footer-spacer" class="pointer-events-none relative z-0" aria-hidden="true"></div>

<style>
  #footer-panel {
    will-change: opacity, transform, filter;
  }

  @media (prefers-reduced-motion: reduce) {
    #footer-panel {
      opacity: 1 !important;
      filter: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const footer = document.getElementById("site-footer");
  const panel = document.getElementById("footer-panel");
  const spacer = document.getElementById("footer-spacer");
  const pageShell = document.getElementById("page-shell");

  if (footer && panel && spacer) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const syncLayout = () => {
      const h = footer.offsetHeight;
      spacer.style.height = `${h}px`;
      if (pageShell) pageShell.style.marginBottom = "0";
    };

    syncLayout();
    window.addEventListener("resize", () => {
      syncLayout();
      ScrollTrigger.refresh();
    }, { passive: true });

    if (reduced) {
      gsap.set(panel, { clearProps: "all" });
    } else {
      gsap.set(panel, {
        opacity: 0,
        y: 56,
        scale: 0.94,
        filter: "blur(10px)",
        transformOrigin: "50% 100%",
      });

      gsap
        .timeline({
          scrollTrigger: {
            trigger: spacer,
            start: "top bottom",
            end: "bottom bottom",
            scrub: 0.55,
            invalidateOnRefresh: true,
          },
        })
        .to(panel, {
          opacity: 1,
          y: 0,
          scale: 1,
          filter: "blur(0px)",
          ease: "none",
          duration: 1,
        });
    }

    ScrollTrigger.addEventListener("refreshInit", syncLayout);
  }
</script>
