---
const links = [
  { label: "Serviços", href: "#servicos" },
  { label: "Cases", href: "#cases" },
  { label: "Como funciona", href: "#processo" },
  { label: "Sobre", href: "#sobre" },
  { label: "FAQ", href: "#faq" },
  { label: "Contato", href: "#contato" },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-muted/30">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-10 mb-10">

      <!-- Marca -->
      <div class="space-y-4">
        <img src="/logo_ovelha.svg" alt="jeanreis.dev.br" class="h-7" />
        <p class="text-sm text-muted-foreground leading-relaxed max-w-xs">
          Engenharia de software sob medida. Produtos web seguros, eficientes e prontos para escalar.
        </p>
        <!-- Redes sociais -->
        <div class="flex items-center gap-3">
          <a
            href="https://github.com/jrcarls"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="h-9 w-9 rounded-lg border border-border bg-card flex items-center justify-center text-muted-foreground hover:text-foreground hover:border-border/80 transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <g><path d="M10 20.568c-3.429 1.157-6.286 0-8-3.568"/><path d="M10 22v-3.242c0-.598.184-1.118.48-1.588c.204-.322.064-.78-.303-.88C7.134 15.452 5 14.107 5 9.645c0-1.16.38-2.25 1.048-3.2c.166-.236.25-.354.27-.46c.02-.108-.015-.247-.085-.527c-.283-1.136-.264-2.343.16-3.43c0 0 .877-.287 2.874.96c.456.285.684.428.885.46s.469-.035 1.005-.169A9.5 9.5 0 0 1 13.5 3a9.6 9.6 0 0 1 2.343.28c.536.134.805.2 1.006.169c.2-.032.428-.175.884-.46c1.997-1.247 2.874-.96 2.874-.96c.424 1.087.443 2.294.16 3.43c-.07.28-.104.42-.084.526s.103.225.269.461c.668.95 1.048 2.04 1.048 3.2c0 4.462-2.134 5.807-5.177 6.643c-.367.101-.507.559-.303.88c.296.47.48.99.48 1.589V22"/></g>
            </svg>
          </a>
          <a
            href="https://www.linkedin.com/in/jeanreis-dev/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="h-9 w-9 rounded-lg border border-border bg-card flex items-center justify-center text-muted-foreground hover:text-foreground hover:border-border/80 transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <g><path d="M7 10v7m4-4v4m0-4a3 3 0 1 1 6 0v4m-6-4v-3M7.125 6.75H7m.25 0a.25.25 0 1 1-.5 0a.25.25 0 0 1 .5 0"/><path d="M3 12c0-4.243 0-6.364 1.318-7.682S7.758 3 12 3s6.364 0 7.682 1.318S21 7.758 21 12s0 6.364-1.318 7.682S16.242 21 12 21s-6.364 0-7.682-1.318S3 16.242 3 12"/></g>
            </svg>
          </a>
          <a
            href="mailto:contato@jeanreis.dev.br"
            aria-label="E-mail"
            class="h-9 w-9 rounded-lg border border-border bg-card flex items-center justify-center text-muted-foreground hover:text-foreground hover:border-border/80 transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
              <g><path d="m2 6l6.913 3.917c2.549 1.444 3.625 1.444 6.174 0L22 6"/><path d="M2.016 13.476c.065 3.065.098 4.598 1.229 5.733c1.131 1.136 2.705 1.175 5.854 1.254c1.94.05 3.862.05 5.802 0c3.149-.079 4.723-.118 5.854-1.254c1.131-1.135 1.164-2.668 1.23-5.733c.02-.986.02-1.966 0-2.952c-.066-3.065-.099-4.598-1.23-5.733c-1.131-1.136-2.705-1.175-5.854-1.254a115 115 0 0 0-5.802 0c-3.149.079-4.723.118-5.854 1.254c-1.131 1.135-1.164 2.668-1.23 5.733a69 69 0 0 0 0 2.952Z"/></g>
            </svg>
          </a>
        </div>
      </div>

      <!-- Links -->
      <div>
        <p class="text-sm font-semibold mb-4">Navegação</p>
        <ul class="space-y-2.5">
          {links.map(link => (
            <li>
              <a href={link.href} class="text-sm text-muted-foreground hover:text-foreground transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- CTA -->
      <div class="rounded-xl border border-border bg-card p-5 space-y-3 h-fit">
        <p class="text-sm font-semibold">Pronto para começar?</p>
        <p class="text-xs text-muted-foreground leading-relaxed">
          Diagnóstico gratuito, sem compromisso. 30 minutos para entender o seu projeto.
        </p>
        <a
          href="#contato"
          class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors"
        >
          Agendar diagnóstico
        </a>
      </div>

    </div>

    <!-- Bottom -->
    <div class="border-t border-border pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-muted-foreground">
      <p>© {year} Jean Reis. Todos os direitos reservados.</p>
      <p class="italic cursor-help" title="Tudo o que você fizer, faça de todo o coração, como para o Senhor, e não para os homens.">Colossenses 3:23</p>
      <p>Feito com muito 🧡 por mim e claude.</p>
    </div>

  </div>
</footer>
