---
import "@/styles/globals.css";
import { Font } from "astro:assets";
import Navbar from "@/components/Navbar.astro";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <!-- bejamas:astro-fonts:start -->
<Font cssVariable="--font-sans" />
<Font cssVariable="--font-logo" />
<!-- bejamas:astro-fonts:end -->
    <script is:inline>
      const theme = localStorage.getItem("theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      if (theme === "dark" || (!theme && prefersDark)) {
        document.documentElement.classList.add("dark");
      }
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO primário -->
    <title>Jean Reis - Desenvolvedor LegalTech para Escritórios de Advocacia</title>
    <meta name="description" content="Desenvolvo sistemas e automações sob medida para escritórios de advocacia. LegalTech, APIs jurídicas e automações que eliminam o retrabalho. Atendimento direto, sem intermediários." />
    <meta name="keywords" content="legaltech, software jurídico, automação jurídica, sistema para escritório de advocacia, desenvolvedor para advogados, Python Django jurídico, desenvolvedor legaltech" />
    <meta name="author" content="Jean Reis" />
    <link rel="canonical" href="https://jeanreis.dev.br/" />

    <!-- Open Graph (WhatsApp, LinkedIn, Facebook) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://jeanreis.dev.br/" />
    <meta property="og:title" content="Jean Reis - Sistemas & Automações para Escritórios de Advocacia" />
    <meta property="og:description" content="Sistemas e automações jurídicas sob medida para escritórios de advocacia. Elimine retrabalho, automatize processos e escale o seu escritório com tecnologia segura." />
    <meta property="og:image" content="https://jeanreis.dev.br/og.png" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Jean Reis - LegalTech" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Jean Reis - Sistemas & Automações para Escritórios de Advocacia" />
    <meta name="twitter:description" content="Sistemas e automações jurídicas sob medida. LegalTech, APIs e produtos web seguros para escritórios de advocacia." />
    <meta name="twitter:image" content="https://jeanreis.dev.br/og.png" />

    <!-- Indexação -->
    <meta name="robots" content="index, follow" />

    <!-- Dados estruturados -->
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Jean Reis",
      "url": "https://jeanreis.dev.br/",
      "jobTitle": "Desenvolvedor de Software LegalTech",
      "description": "Desenvolvedor especializado em sistemas e automações para escritórios de advocacia. LegalTech, APIs jurídicas e segurança de aplicações.",
      "knowsAbout": ["LegalTech", "Automação Jurídica", "Software Jurídico", "Python", "Django", "FastAPI", "AppSec", "OWASP"],
      "offers": [
        {
          "@type": "Offer",
          "name": "Sistemas e Automações para Escritórios de Advocacia",
          "description": "Desenvolvimento de sistemas jurídicos sob medida, automações de processos e APIs para escritórios de advocacia."
        },
        {
          "@type": "Offer",
          "name": "AppSec & Segurança de Aplicações",
          "description": "Auditoria de segurança com metodologia OWASP, revisão de código e análise estática para produtos web."
        }
      ],
      "sameAs": []
    }
    </script>
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quanto custa um projeto?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depende do escopo. Auditorias de segurança partem de R$ 2.500 e projetos de desenvolvimento são orçados sob medida após o diagnóstico gratuito. Não trabalho com tabela fixa porque cada produto tem complexidade diferente, prefiro entender o seu problema antes de colocar um número."
          }
        },
        {
          "@type": "Question",
          "name": "Quanto tempo leva para entregar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Uma auditoria AppSec leva de 1 a 2 semanas. Projetos de desenvolvimento variam: MVPs simples saem em 4 a 6 semanas, produtos mais completos entre 8 e 12 semanas. Sempre defino um cronograma realista na proposta, sem promessa de prazo impossível."
          }
        },
        {
          "@type": "Question",
          "name": "Como funciona o diagnóstico gratuito?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "É uma conversa de 30 a 45 minutos onde entendo o seu produto, os problemas que você quer resolver e o que você espera como resultado. Sem compromisso. No final você sai com clareza sobre o que fazer, independente de fechar comigo ou não."
          }
        },
        {
          "@type": "Question",
          "name": "Você tem experiência com sistemas para escritórios de advocacia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim. Tenho histórico prático em LegalTech, desenvolvendo sistemas e automações para escritórios de advocacia. Esse contexto me permite entender as dores do negócio jurídico antes de escrever a primeira linha de código: gestão de prazos, controle de processos, automação de documentos e integrações com sistemas do Poder Judiciário."
          }
        },
        {
          "@type": "Question",
          "name": "Você consegue atender bem sendo solo dev?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Essa é exatamente a vantagem. Sendo solo, escolho cuidadosamente quantos projetos aceito por vez. Quando o seu projeto entra na minha agenda, ele tem atenção total, não fica esperando na fila de um time ou sendo repassado para diversos desenvolvedores."
          }
        },
        {
          "@type": "Question",
          "name": "Você trabalha com contrato?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim, sempre. Todo projeto começa com um contrato claro definindo escopo, prazo, valor e condições de pagamento. Isso protege os dois lados e evita desentendimentos no meio do caminho."
          }
        }
      ]
    }
    </script>
  </head>
  <body>
    <Navbar />
    <main class="pt-16">
      <slot />
    </main>

    <!-- Botão voltar ao topo -->
    <button
      id="back-to-top"
      aria-label="Voltar ao topo"
      class="fixed bottom-6 right-6 z-50 h-11 w-11 rounded-full border border-border bg-card shadow-lg flex items-center justify-center text-muted-foreground hover:text-foreground hover:bg-muted hover:shadow-xl transition-colors opacity-0 pointer-events-none"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 19V5M5 12l7-7 7 7"/>
      </svg>
    </button>

    <script>
      import { animate, inView } from "motion";

      document.querySelectorAll<HTMLElement>("[data-reveal]").forEach((el) => {
        const delay = parseFloat(el.dataset.revealDelay ?? "0");
        el.style.opacity = "0";
        el.style.transform = "translateY(32px)";

        inView(el, () => {
          animate(
            el as Element,
            { opacity: [0, 1], y: [32, 0] },
            { duration: 0.6, delay, easing: [0.25, 0.1, 0.25, 1] },
          );
        }, { amount: 0.2 });
      });

      // Botão voltar ao topo
      const btn = document.getElementById("back-to-top");
      let visible = false;

      window.addEventListener("scroll", () => {
        const shouldShow = window.scrollY > 400;
        if (shouldShow === visible) return;
        visible = shouldShow;

        if (shouldShow) {
          btn!.style.pointerEvents = "auto";
          animate(btn!, { opacity: [0, 1], y: [16, 0], scale: [0.8, 1] }, { duration: 0.35, easing: [0.34, 1.56, 0.64, 1] });
        } else {
          animate(btn!, { opacity: [1, 0], y: [0, 16], scale: [1, 0.8] }, { duration: 0.25, easing: "ease-in" }).then(() => {
            btn!.style.pointerEvents = "none";
          });
        }
      }, { passive: true });

      btn?.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    </script>
  </body>
</html>
