---
import "@/styles/globals.css";
import { Font } from "astro:assets";
import Navbar from "@/components/Navbar.astro";
import CursorFollow from "@/components/CursorFollow.astro";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <!-- bejamas:astro-fonts:start -->
<Font cssVariable="--font-sans" />
<Font cssVariable="--font-logo" />
<Font cssVariable="--font-display" />
<!-- bejamas:astro-fonts:end -->
    <script is:inline>
      const theme = localStorage.getItem("theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      if (theme === "dark" || (!theme && prefersDark)) {
        document.documentElement.classList.add("dark");
      }
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/avatar.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO primário -->
    <title>Jean Reis - Engenheiro de Software</title>
    <meta name="description" content="Análise e desenvolvimento de sistemas, APIs e produtos web sob medida que resolvem problemas reais de negócio, incluindo agentes de IA e automações inteligentes quando faz sentido. Salvador, BA - atendimento nacional." />
    <meta name="keywords" content="analista de sistemas, desenvolvedor de sistemas, desenvolvimento de sistemas sob medida, API, produto web, automação inteligente, agente de IA, RAG, LLM, MCP, OpenAI, Anthropic, LangChain, Python, TypeScript" />
    <meta name="author" content="Jean Reis" />
    <link rel="canonical" href="https://jeanreis.dev.br/" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://jeanreis.dev.br/" />
    <meta property="og:title" content="Jean Reis - Engenheiro de Software" />
    <meta property="og:description" content="Análise e desenvolvimento de sistemas, APIs e produtos web sob medida, incluindo agentes de IA e automações inteligentes quando faz sentido." />
    <meta property="og:image" content="https://jeanreis.dev.br/og.svg" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Jean Reis - Engenheiro de Software" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Jean Reis - Engenheiro de Software" />
    <meta name="twitter:description" content="Análise e desenvolvimento de sistemas, APIs e produtos web sob medida, incluindo agentes de IA e automações inteligentes quando faz sentido." />
    <meta name="twitter:image" content="https://jeanreis.dev.br/og.svg" />

    <!-- Indexação -->
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#4338ca" />

    <!-- Dados estruturados -->
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "ProfessionalService",
          "@id": "https://jeanreis.dev.br/#service",
          "name": "Jean Reis - Engenheiro de Software",
          "url": "https://jeanreis.dev.br/",
          "description": "Análise e desenvolvimento de sistemas, APIs e produtos web sob medida que resolvem problemas reais de negócio, incluindo agentes de IA e automações inteligentes quando faz sentido.",
          "areaServed": "Brasil",
          "priceRange": "$$",
          "telephone": "+5571991516655",
          "email": "contato@jeanreis.dev.br",
          "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "Serviços",
            "itemListElement": [
              {
                "@type": "Offer",
                "itemOffered": {
                  "@type": "Service",
                  "name": "Análise de Requisitos e Arquitetura de Solução",
                  "description": "Levantamento de requisitos, mapeamento de processos e definição de arquitetura e stack antes do desenvolvimento."
                }
              },
              {
                "@type": "Offer",
                "itemOffered": {
                  "@type": "Service",
                  "name": "Desenvolvimento de Sistemas, APIs e Agentes de IA",
                  "description": "Desenvolvimento de APIs REST, produtos web full-stack, automações de processos e agentes de IA com pipelines RAG e integrações com LLMs."
                }
              }
            ]
          },
          "founder": {
            "@type": "Person",
            "name": "Jean Reis",
            "jobTitle": "Engenheiro de Software",
            "url": "https://jeanreis.dev.br/",
            "sameAs": [
              "https://github.com/jrcarls",
              "https://www.linkedin.com/in/jeanreis-dev/"
            ]
          }
        },
        {
          "@type": "WebSite",
          "@id": "https://jeanreis.dev.br/#website",
          "url": "https://jeanreis.dev.br/",
          "name": "Jean Reis - Engenheiro de Software",
          "description": "Engenheiro de software especializado em APIs, produtos web e automações inteligentes para empresas de qualquer segmento.",
          "inLanguage": "pt-BR"
        }
      ]
    }
    </script>
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Que tipo de sistemas você desenvolve?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sistemas web, APIs, automações de processos e produtos sob medida para empresas de diferentes segmentos. Do backend ao produto completo, incluindo integrações com sistemas externos e, quando faz sentido, agentes de IA e automações inteligentes."
          }
        },
        {
          "@type": "Question",
          "name": "Você faz análise antes de começar a desenvolver?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sempre. Antes de escrever qualquer linha de código, entendo o problema, o processo atual e o resultado esperado. Isso evita retrabalho e garante que a solução escolhida (arquitetura, stack, escopo) seja a mais adequada para o seu caso, não a mais na moda."
          }
        },
        {
          "@type": "Question",
          "name": "Quanto custa um projeto?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depende do escopo. Automações e integrações simples partem de R$ 3.000, sistemas e agentes mais completos são orçados sob medida após o diagnóstico gratuito. Não trabalho com tabela fixa porque cada projeto tem complexidade diferente, prefiro entender o seu problema antes de colocar um número."
          }
        },
        {
          "@type": "Question",
          "name": "Quanto tempo leva para entregar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Integrações e automações simples saem em 2 a 4 semanas. Sistemas com múltiplos módulos ou agentes com múltiplas ferramentas levam de 6 a 10 semanas. Sempre defino um cronograma realista na proposta, sem promessa de prazo impossível."
          }
        },
        {
          "@type": "Question",
          "name": "Qual a diferença entre chamar uma API de LLM e ter um agente de IA?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Chamar uma API é mandar uma pergunta e receber uma resposta. Um agente tem ferramentas, memória e lógica de decisão, ele pode buscar dados, executar ações, consultar bases de conhecimento e encadear múltiplos passos para resolver um problema de forma autônoma. A diferença em resultado é enorme."
          }
        },
        {
          "@type": "Question",
          "name": "Como funciona um pipeline RAG e quando faz sentido usar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "RAG (Retrieval-Augmented Generation) é a técnica de dar ao LLM acesso à sua base de conhecimento própria, documentos, manuais, histórico de atendimentos, no momento da resposta. Faz sentido quando você precisa que o modelo responda com base em informações específicas da sua empresa, que não estão no treinamento do modelo."
          }
        },
        {
          "@type": "Question",
          "name": "Como funciona o diagnóstico gratuito?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "É uma conversa de 30 a 45 minutos onde entendo o seu produto, os processos que você quer automatizar e o que você espera como resultado. Sem compromisso. No final você sai com clareza sobre o que fazer, independente de fechar comigo ou não."
          }
        },
        {
          "@type": "Question",
          "name": "Você trabalha com contrato?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim, sempre. Todo projeto começa com um contrato claro definindo escopo, prazo, valor e condições de pagamento. Isso protege os dois lados e evita desentendimentos no meio do caminho."
          }
        }
      ]
    }
    </script>
  </head>
  <body>
    <Navbar />
    <CursorFollow />
    <main class="pt-16">
      <slot />
    </main>

    <!-- Botão WhatsApp flutuante -->
    <a
      id="whatsapp-fab"
      href="https://wa.me/5571991516655?text=Olá%2C%20vim%20pelo%20site%20jeanreis.dev.br%20e%20gostaria%20de%20conversar%20sobre%20um%20projeto."
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Fale pelo WhatsApp"
      class="fixed bottom-20 right-6 z-50 group flex items-center gap-2 opacity-0"
    >
      <span class="hidden group-hover:block text-xs font-medium bg-card border border-border rounded-lg px-2.5 py-1.5 shadow-md whitespace-nowrap transition-all">
        Fale pelo WhatsApp
      </span>
      <div class="h-11 w-11 rounded-full flex items-center justify-center shadow-lg transition-transform group-hover:scale-110" style="background-color:#25D366">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="white">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967c-.273-.099-.471-.148-.67.15c-.197.297-.767.966-.94 1.164c-.173.199-.347.223-.644.075c-.297-.15-1.255-.463-2.39-1.475c-.883-.788-1.48-1.761-1.653-2.059c-.173-.297-.018-.458.13-.606c.134-.133.298-.347.446-.52c.149-.174.198-.298.298-.497c.099-.198.05-.371-.025-.52c-.075-.149-.669-1.612-.916-2.207c-.242-.579-.487-.5-.669-.51a13 13 0 0 0-.57-.01c-.198 0-.52.074-.792.372c-.272.297-1.04 1.016-1.04 2.479c0 1.462 1.065 2.875 1.213 3.074c.149.198 2.096 3.2 5.077 4.487c.709.306 1.262.489 1.694.625c.712.227 1.36.195 1.871.118c.571-.085 1.758-.719 2.006-1.413c.248-.694.248-1.289.173-1.413c-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214l-3.741.982l.998-3.648l-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884c2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.9 11.9 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.82 11.82 0 0 0-3.48-8.413Z"/>
        </svg>
      </div>
    </a>

    <!-- Botão voltar ao topo -->
    <button
      id="back-to-top"
      aria-label="Voltar ao topo"
      class="fixed bottom-6 right-6 z-50 h-11 w-11 rounded-full border border-border bg-card shadow-lg flex items-center justify-center text-muted-foreground hover:text-foreground hover:bg-muted hover:shadow-xl transition-colors opacity-0 pointer-events-none"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 19V5M5 12l7-7 7 7"/>
      </svg>
    </button>

    <script>
      import { animate, inView } from "motion";

      document.querySelectorAll<HTMLElement>("[data-reveal]").forEach((el) => {
        const delay = parseFloat(el.dataset.revealDelay ?? "0");
        el.style.opacity = "0";
        el.style.transform = "translateY(32px)";

        inView(el, () => {
          animate(
            el as Element,
            { opacity: [0, 1], y: [32, 0] },
            { duration: 0.6, delay, easing: [0.25, 0.1, 0.25, 1] },
          );
        }, { amount: 0.2 });
      });

      // Botão WhatsApp
      const wab = document.getElementById("whatsapp-fab");
      if (wab) {
        setTimeout(() => {
          animate(wab, { opacity: [0, 1], scale: [0.7, 1] }, { duration: 0.4, easing: [0.34, 1.56, 0.64, 1] });
        }, 1500);
      }

      // Botão voltar ao topo
      const btn = document.getElementById("back-to-top");
      let visible = false;

      window.addEventListener("scroll", () => {
        const shouldShow = window.scrollY > 400;
        if (shouldShow === visible) return;
        visible = shouldShow;

        if (shouldShow) {
          btn!.style.pointerEvents = "auto";
          animate(btn!, { opacity: [0, 1], y: [16, 0], scale: [0.8, 1] }, { duration: 0.35, easing: [0.34, 1.56, 0.64, 1] });
        } else {
          animate(btn!, { opacity: [1, 0], y: [0, 16], scale: [1, 0.8] }, { duration: 0.25, easing: "ease-in" }).then(() => {
            btn!.style.pointerEvents = "none";
          });
        }
      }, { passive: true });

      btn?.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    </script>
  </body>
</html>
