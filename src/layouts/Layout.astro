---
import "@/styles/globals.css";
import { Font } from "astro:assets";
import Navbar from "@/components/Navbar.astro";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <!-- bejamas:astro-fonts:start -->
<Font cssVariable="--font-sans" />
<Font cssVariable="--font-logo" />
<!-- bejamas:astro-fonts:end -->
    <script is:inline>
      const theme = localStorage.getItem("theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      if (theme === "dark" || (!theme && prefersDark)) {
        document.documentElement.classList.add("dark");
      }
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO primário -->
    <title>Ovelha Tech — Engenharia de Software sob Medida</title>
    <meta name="description" content="Dev especializado em Python, Django e AppSec. Construo produtos web seguros, eficientes e prontos para escalar. Atendimento direto, sem intermediários." />
    <meta name="author" content="Jean Reis" />
    <link rel="canonical" href="https://ovelhatech.com.br/" />

    <!-- Open Graph (WhatsApp, LinkedIn, Facebook) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://ovelhatech.com.br/" />
    <meta property="og:title" content="Ovelha Tech — Engenharia de Software sob Medida" />
    <meta property="og:description" content="Dev especializado em Python, Django e AppSec. Produtos web seguros e prontos para escalar. Atendimento direto, sem intermediários." />
    <meta property="og:image" content="https://ovelhatech.com.br/og.png" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Ovelha Tech" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Ovelha Tech — Engenharia de Software sob Medida" />
    <meta name="twitter:description" content="Dev especializado em Python, Django e AppSec. Produtos web seguros e prontos para escalar." />
    <meta name="twitter:image" content="https://ovelhatech.com.br/og.png" />

    <!-- Indexação -->
    <meta name="robots" content="index, follow" />
  </head>
  <body>
    <Navbar />
    <main class="pt-16">
      <slot />
    </main>

    <!-- Botão voltar ao topo -->
    <button
      id="back-to-top"
      aria-label="Voltar ao topo"
      class="fixed bottom-6 right-6 z-50 h-11 w-11 rounded-full border border-border bg-card shadow-lg flex items-center justify-center text-muted-foreground hover:text-foreground hover:bg-muted hover:shadow-xl transition-colors opacity-0 pointer-events-none"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 19V5M5 12l7-7 7 7"/>
      </svg>
    </button>

    <script>
      import { animate, inView } from "motion";

      document.querySelectorAll<HTMLElement>("[data-reveal]").forEach((el) => {
        const delay = parseFloat(el.dataset.revealDelay ?? "0");
        el.style.opacity = "0";
        el.style.transform = "translateY(32px)";

        inView(el, () => {
          animate(
            el as Element,
            { opacity: [0, 1], y: [32, 0] },
            { duration: 0.6, delay, easing: [0.25, 0.1, 0.25, 1] },
          );
        }, { amount: 0.2 });
      });

      // Botão voltar ao topo
      const btn = document.getElementById("back-to-top");
      let visible = false;

      window.addEventListener("scroll", () => {
        const shouldShow = window.scrollY > 400;
        if (shouldShow === visible) return;
        visible = shouldShow;

        if (shouldShow) {
          btn!.style.pointerEvents = "auto";
          animate(btn!, { opacity: [0, 1], y: [16, 0], scale: [0.8, 1] }, { duration: 0.35, easing: [0.34, 1.56, 0.64, 1] });
        } else {
          animate(btn!, { opacity: [1, 0], y: [0, 16], scale: [1, 0.8] }, { duration: 0.25, easing: "ease-in" }).then(() => {
            btn!.style.pointerEvents = "none";
          });
        }
      }, { passive: true });

      btn?.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    </script>
  </body>
</html>
